+                  </button>
+                  <button
+                    onClick={adicionarFotoDaGaleria}
+                    disabled={publicando}
+                    className="relative aspect-square cursor-pointer rounded-2xl border-2 border-dashed border-border bg-surface-2 p-4 flex flex-col items-center gap-2 text-sm transition hover:border-accent"
+                  >
+                    <Lightbulb className="h-10 w-10 text-accent" />
+                    <span>Galeria</span>
+                  </button>
+                </div>
+              )}
+            </div>
+
+            {/* Legenda */}
+            <textarea
+              value={legenda}
+              onChange={(e) => setLegenda(e.target.value)}
+              rows={4}
+              placeholder={categorias.find(c => c.value === categoria)?.label === "Dica de estudo" ? "Compartilhe sua dica…" : "Escreva aqui…"}
+              className="w-full rounded-xl border border-input bg-background px-4 py-2 text-sm text-foreground resize-none"
+              maxLength={STUDY_RATS.LIMITES.MAX_LEGENDA}
+              disabled={publicando}
+            />
+            <p className="text-right text-xs text-muted-foreground">{legenda.length}/{STUDY_RATS.LIMITES.MAX_LEGENDA}</p>
+          </div>
+        )}
+
+        {/* Modal de câmera */}
+        {mostrarCamera && (
+          <div className="srx-overlay fixed inset-0 z-50 flex items-center justify-center p-4" onClick={pararStream}>
+            <div className="srx-sheet srx-card relative w-full max-w-sm" onClick={(e) => e.stopPropagation()}>
+              <header className="sticky top-0 flex items-center justify-between border-b border-border bg-surface px-4 py-3">
+                <span className="text-sm font-semibold text-foreground">Câmera</span>
+                <button onClick={pararStream} className="text-muted-foreground"><X className="h-5 w-5" /></button>
+              </header>
+              <div className="relative aspect-square bg-black">
+                <video
+                  ref={videoRef}
+                  autoPlay
+                  playsInline
+                  muted
+                  className="absolute inset-0 h-full w-full object-cover"
+                  style={{ transform: cameraFacingMode === "user" ? "scaleX(-1)" : "none" }}
+                />
+                <canvas ref={canvasRef} className="hidden" />
+                {/* Guia quadrado central */}
+                <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
+                  <div className="w-[80%] aspect-square border-2 border-white/50 rounded-xl" />
+                </div>
+              </div>
+              <div className="flex items-center justify-between px-4 py-4 gap-4">
+                <button onClick={alternarCamera} className="srx-fab flex-1 flex items-center justify-center gap-2 rounded-full py-2 text-sm font-bold">
+                  <RotateCcw className="h-4 w-4" /> Trocar
+                </button>
+                <button onClick={capturarFoto} className="srx-fab flex-1 flex items-center justify-center gap-2 rounded-full py-2 text-sm font-bold">
+                  <Camera className="h-4 w-4" /> Capturar
+                </button>
+              </div>
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
\ No newline at end of file
diff --git a/src/components/study-rats/README.md b/src/components/study-rats/README.md
new file mode 100644
index 00000000..38813469
--- /dev/null
+++ b/src/components/study-rats/README.md
@@ -0,0 +1,39 @@
+# Study Rats v7 — protótipo visual (Una Vox) · estilo Instagram
+
+Telas **somente visuais** (dados falsos, sem banco). Mesmo padrão da pasta `aulas-redesign/`.
+
+## O que mudou da v3
+- Feed estilo Instagram: stories com anel degradê (visto/não visto) + visualizador com barra de progresso, carrossel de fotos com pontinhos e contador 1/N, curtir com duplo toque (coração animado), compartilhar, salvar, "Curtido por X e outras N pessoas", chip da matéria, selo de tempo estudado sobre a foto.
+- Comentários em painel inferior (bottom sheet) com atalhos de emoji.
+- Nova publicação: foto quadrada, escolha da matéria, controle de tempo de estudo e legenda.
+- Calendários: resumo (registros, horas, dias seguidos), dias com foto redonda, contador de registros, painel do dia e botão "Novo registro".
+- **Meu perfil** (Comunidade › Study Rats): perfil do estudante igual ao Instagram — foto, publicações, amizades, horas estudadas, bio, "Editar perfil", "Nova publicação" e grade de publicações / Salvos.
+- A Galeria saiu de Calendários: **tudo é postado pela Comunidade** e as fotos aparecem automaticamente no calendário.
+
+## Novidades v7
+- **Onde publicar**: ao criar (check-in ou publicação) escolha **Feed · para sempre** ou **Stories · 24h**, igual ao Instagram.
+  - Story some depois de 24h; ao abrir, cada story passa sozinho em 5 segundos (tocar nas laterais volta/avança).
+  - Story de texto vira cartão colorido com a categoria; story com foto mostra a foto + legenda.
+  - Check-in postado como story **continua salvo no calendário** mesmo depois que o story some.
+  - "Seu story" ganha anel quando há story ativo; o "+" pequeno cria outro. No seu story aparece "Visto por N pessoas · some em 24h".
+
+## Novidades v6
+- **Dois tipos de publicação** (escolhidos no botão "+" / "Criar"):
+  - **Check-in de estudo**: foto obrigatória + matéria + tempo → aparece no feed, no perfil (aba Check-ins) **e no calendário**.
+  - **Publicação**: dica de estudo, curiosidade, dúvida ou motivação, texto + disciplina e imagem opcionais → feed e perfil (aba Publicações), **não** vai para o calendário.
+- Filtros no feed: Tudo · Check-ins · Dica de estudo · Curiosidade · Dúvida · Motivação.
+- **Mobile**: barra inferior (Comunidade · + · Calendários), criar abre como painel de baixo.
+- **Desktop**: coluna lateral com "Seu dia" (horas de hoje + Fazer check-in), "Em alta na comunidade" e "Sugestões para você"; botão "+" flutuante.
+
+## Arquivos
+- `StudyRatsFeed.tsx` — feed + stories + comentários + `NovaPublicacaoModal`.
+- `StudyRatsPerfil.tsx` — perfil do estudante (grade estilo Instagram).
+- `StudyRatsCalendario.tsx` — calendário (somente leitura) + visualizador; prop `onIrParaComunidade`.
+- `StudyRatsStyles.tsx` — estilos locais com tokens do Una Vox (`--surface`, `--surface-2`, `--border`, `--primary`, `--accent`…).
+- `mock-data.ts` — dados de exemplo + store local (`studyRatsStore`, `useStudyRats`) que simula o backend.
+- `study-rats-store.test.ts` — teste da regra: só check-in vai para o calendário. `fotos-exemplo/` — fotos usadas no protótipo (copiar para `public/study-rats/` só para testar).
+
+## Como usar
+1. Copie a pasta para `src/components/study-rats/`.
+2. Comunidade (`src/routes/comunidade.tsx`): aba `studyrats` no `BotaoTab`, renderizando `<StudyRatsFeed />`.
+3. Calendários (`src/routes/calendario.tsx`): renderize `<StudyRatsCalendario />`.
diff --git a/src/components/study-rats/StudyRatsFeed.tsx b/src/components/study-rats/StudyRatsFeed.tsx
new file mode 100644
index 00000000..f977e9c6
--- /dev/null
+++ b/src/components/study-rats/StudyRatsFeed.tsx
@@ -0,0 +1,957 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Bookmark, BookOpen, CalendarCheck, Camera, ChevronLeft, Clock, Flame, Heart, Lightbulb, MessageCircle, MoreHorizontal, X } from "lucide-react";
+import { useStudyFeed, useStories, invalidateStudyFeedCache, useStudyProfile } from "@/hooks/useStudyRats";
+import { useStudyRatsCheckins } from "@/contexts/StudyRatsContext";
+import { getCachedUserId, addComment, getComments, deleteComment, deletePost, studyRatsErrorMessage } from "@/services/studyRatsService";
+import { STUDY_RATS, STUDY_RATS_CATEGORIAS } from "@/constants";
+import { fmtDuracao, tempoRelativo } from "@/utils/studyRatsFormat";
+import { localDateStr } from "@/utils/date";
+import { UserAvatar } from "@/components/ui/UserAvatar";
+import { StudyRatsStyles } from "./StudyRatsStyles";
+import { useConfirm } from "@/components/ConfirmDialog";
+import { NovaPublicacaoModal } from "./NovaPublicacaoModal";
+import { useAppUser } from "@/contexts/UserContext";
+import { StudyRatsPerfil } from "./StudyRatsPerfil";
+import type { StudyPost, StudyStory, StudyComment, StudyAuthor } from "@/types/studyRats";
+
+/** Feed do Study Rats — usa hooks reais (Fase 3). */
+export function StudyRatsFeed() {
+  const [filtro, setFiltro] = useState<string>("Tudo");
+  const [storyFila, setStoryFila] = useState<string[] | null>(null);
+  const [storyPos, setStoryPos] = useState(0);
+  const [comentando, setComentando] = useState<string | null>(null);
+  const [criando, setCriando] = useState<"checkin" | "post" | "escolher" | null>(null);
+  const [trendingPosts, setTrendingPosts] = useState<StudyPost[]>([]);
+  const [feedError, setFeedError] = useState<string | null>(null);
+
+  // Estados para navegação Feed ↔ Perfil
+  const [view, setView] = useState<"feed" | "perfil">("feed");
+  const [perfilUserId, setPerfilUserId] = useState<string | null>(null);
+  const [perfilKey, setPerfilKey] = useState(0);
+
+  // Meus check-ins (do contexto local) — para "Seu dia"
+  const { checkins: meusCheckins, userId, deleteCheckin } = useStudyRatsCheckins();
+  const { user: appUser } = useAppUser();
+
+  // Avatar real da usuária atual — useStudyProfile() sem argumentos
+  const { profile: meuPerfil } = useStudyProfile();
+  const currentUserAvatar = {
+    nome: meuPerfil?.name ?? appUser?.fullName ?? "Você",
+    fotoUrl: meuPerfil?.avatarUrl ?? null,
+    avatarTipo: meuPerfil?.avatarTipo ?? null,
+    avatarId: meuPerfil?.avatarId ?? null,
+  };
+
+  // Feed paginado - A1: corrigir filtro por categoria (usar value, não label)
+  const categoriaDoFiltro = STUDY_RATS_CATEGORIAS.find(c => c.label === filtro)?.value;
+  const filter = filtro === "Tudo"
+    ? undefined
+    : filtro === "Check-ins"
+      ? { kind: STUDY_RATS.TIPOS.CHECKIN }
+      : categoriaDoFiltro
+        ? { category: categoriaDoFiltro }
+        : undefined;
+  const { posts, loading, loadingMore, error, hasMore, refresh, loadMore, likePost, savePost, updateCommentsCount } = useStudyFeed(filter);
+
+  // Stories
+  const { stories, refresh: refreshStories, markViewed: markStoryViewedHook } = useStories();
+
+  // Confirmação para exclusão
+  const confirmDialog = useConfirm();
+
+  // Refs para carregar mais ao chegar no fim (intersection observer)
+  const loadMoreRef = useRef<HTMLDivElement>(null);
+  const loadMoreObserver = useRef<IntersectionObserver | null>(null);
+
+  // Agrupar stories por autor (um anel por pessoa)
+  const groupedStories = useMemo(() => {
+    const byAuthor = new Map<string, StudyStory[]>();
+    for (const story of stories) {
+      const list = byAuthor.get(story.author.id) ?? [];
+      list.push(story);
+      byAuthor.set(story.author.id, list);
+    }
+
+    // Ordenar dentro de cada grupo: cronológico (mais antigo primeiro) para assistir
+    const myId = getCachedUserId();
+    const groups = Array.from(byAuthor.entries()).map(([authorId, authorStories]) => ({
+      authorId,
+      stories: authorStories.sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime()),
+      author: authorStories[0].author,
+      isMe: authorId === myId,
+    }));
+
+    // Separar meu grupo dos demais
+    const meuGrupo = groups.find(g => g.isMe);
+    const amigas = groups.filter(g => !g.isMe);
+
+    // Ordenar amigas: não vistas primeiro, depois por data do story mais recente
+    amigas.sort((a, b) => {
+      const aHasUnviewed = a.stories.some(s => !s.viewedByMe);
+      const bHasUnviewed = b.stories.some(s => !s.viewedByMe);
+      if (aHasUnviewed !== bHasUnviewed) return aHasUnviewed ? -1 : 1;
+      // Mais recentes primeiro para ordenação dos anéis
+      const aLatest = Math.max(...a.stories.map(s => new Date(s.createdAt).getTime()));
+      const bLatest = Math.max(...b.stories.map(s => new Date(s.createdAt).getTime()));
+      return bLatest - aLatest;
+    });
+
+    // Reconstruir array com meu grupo primeiro
+    const result = meuGrupo ? [meuGrupo, ...amigas] : amigas;
+    return result;
+  }, [stories]);
+
+  // Calcular horas de hoje (soma dos check-ins da própria usuária com data de hoje)
+  const hoje = localDateStr();
+  const minHoje = useMemo(() => {
+    return meusCheckins
+      .filter(c => c.study_date === hoje)
+      .reduce((s, c) => s + c.duration_min, 0);
+  }, [meusCheckins, hoje]);
+
+  // Calcular "Em alta na comunidade" — posts do feed "Tudo" de outras autoras, últimos 7 dias, com likes > 0
+  useEffect(() => {
+    if (filtro !== "Tudo") return;
+
+    const seteDiasAtras = new Date();
+    seteDiasAtras.setDate(seteDiasAtras.getDate() - 7);
+    const seteDiasAtrasISO = seteDiasAtras.toISOString();
+
+    const myId = getCachedUserId();
+    const trending = posts
+      .filter(p => p.author.id !== myId)
+      .filter(p => p.likesCount > 0)
+      .filter(p => new Date(p.createdAt).toISOString() >= seteDiasAtrasISO)
+      .sort((a, b) => b.likesCount - a.likesCount)
+      .slice(0, 3);
+
+    setTrendingPosts(trending);
+  }, [posts, filtro]);
+
+  // Intersection observer para loadMore
+  useEffect(() => {
+    if (loadMoreObserver.current) loadMoreObserver.current.disconnect();
+
+    loadMoreObserver.current = new IntersectionObserver((entries) => {
+      if (entries[0].isIntersecting && hasMore && !loadingMore) {
+        loadMore();
+      }
+    }, { threshold: 0.1, rootMargin: "100px" });
+
+    if (loadMoreRef.current) loadMoreObserver.current.observe(loadMoreRef.current);
+
+    return () => {
+      if (loadMoreObserver.current) loadMoreObserver.current.disconnect();
+    };
+  }, [hasMore, loadingMore, loadMore]);
+
+  // A2: Fila fixa de stories — snapshot dos authorIds ao abrir
+  const abrirStory = useCallback((groupIndex: number, storyIndex: number = 0) => {
+    const group = groupedStories[groupIndex];
+    if (!group) return;
+    const story = group.stories[storyIndex];
+    if (!story) return;
+    const fila = groupedStories.map(g => g.authorId);
+    setStoryFila(fila);
+    setStoryPos(groupIndex);
+  }, [groupedStories]);
+
+  // Ações do feed
+  const handleLike = useCallback(async (postId: string, onlyLike = false) => {
+    await likePost(postId, onlyLike);
+  }, [likePost]);
+
+  const handleSave = useCallback(async (postId: string) => {
+    await savePost(postId);
+  }, [savePost]);
+
+  const handleComment = useCallback((postId: string) => {
+    setComentando(postId);
+  }, []);
+
+  const handleDeletePost = useCallback(async (post: StudyPost) => {
+    const ok = await confirmDialog({
+      title: "Excluir publicação?",
+      description: "Esta ação não pode ser desfeita.",
+      confirmText: "Excluir",
+      destructive: true,
+    });
+    if (!ok) return;
+
+    try {
+      if (post.kind === "checkin") {
+        await deleteCheckin(post.id);
+      } else {
+        await deletePost(post.id);
+      }
+    } catch (err) {
+      setFeedError(studyRatsErrorMessage(err));
+      return;
+    }
+
+    // Invalidar cache e atualizar
+    invalidateStudyFeedCache();
+    refresh();
+    refreshStories();
+  }, [confirmDialog, refresh, refreshStories, deleteCheckin]);
+
+  const [editando, setEditando] = useState<StudyPost | null>(null);
+
+  const handleEditPost = useCallback((post: StudyPost) => {
+    setEditando(post);
+  }, []);
+
+  // Callback para abrir perfil do autor
+  const handleOpenProfile = useCallback((authorId: string) => {
+    const myId = getCachedUserId();
+    if (authorId === myId) {
+      setView("perfil");
+      setPerfilUserId(null); // null = meu perfil
+    } else {
+      setView("perfil");
+      setPerfilUserId(authorId);
+    }
+  }, []);
+
+  // Variável para o post que está sendo comentado (movida para fora do JSX - fix F2)
+  const postComentando = posts.find(p => p.id === comentando);
+
+  // Renderização
+  const filtros = ["Tudo", "Check-ins", ...STUDY_RATS_CATEGORIAS.map(c => c.label)];
+
+  return (
+    <div className="mx-auto grid max-w-[1000px] gap-8 lg:grid-cols-[minmax(0,520px)_300px] lg:justify-center">
+      <StudyRatsStyles />
+      <div className="min-w-0 space-y-5">
+        {/* Seletor Feed / Perfil */}
+        <div className="flex justify-center">
+          <div className="srx-seg">
+            <button
+              onClick={() => { setView("feed"); setPerfilUserId(null); }}
+              data-on={view === "feed"}
+              className="text-sm font-semibold"
+            >
+              Feed
+            </button>
+            <button
+              onClick={() => { setView("perfil"); setPerfilUserId(null); }}
+              data-on={view === "perfil" && perfilUserId === null}
+              className="text-sm font-semibold"
+            >
+              Meu perfil
+            </button>
+          </div>
+        </div>
+
+        {view === "feed" ? (
+          <>
+            {/* Hero */}
+            <section className="srx-hero p-5 text-primary-foreground">
+              <div className="flex items-center gap-3">
+                <span className="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-accent text-accent-foreground">
+                  <BookOpen className="h-5 w-5" />
+                </span>
+                <div className="min-w-0">
+                  <h2 className="text-lg font-bold leading-tight">Study Rats</h2>
+                  <p className="text-sm opacity-80">A comunidade de quem estuda junto.</p>
+                </div>
+              </div>
+              <button onClick={() => setCriando("escolher")} className="mt-4 flex w-full items-center gap-3 rounded-full bg-background/25 p-2 pr-4 text-left text-sm transition hover:bg-background/35">
+                <UserAvatar
+                  fotoUrl={currentUserAvatar.fotoUrl}
+                  avatarTipo={currentUserAvatar.avatarTipo}
+                  avatarId={currentUserAvatar.avatarId}
+                  nome={currentUserAvatar.nome}
+                  className="h-8 w-8"
+                />
+                <span className="opacity-85">Compartilhe algo com a comunidade…</span>
+              </button>
+              <div className="mt-3 grid grid-cols-2 gap-2">
+                <button onClick={() => setCriando("checkin")} className="flex items-center justify-center gap-2 rounded-2xl bg-background/25 py-2.5 text-sm font-semibold hover:bg-background/35">
+                  <CalendarCheck className="h-4 w-4 text-accent" /> Check-in
+                </button>
+                <button onClick={() => setCriando("post")} className="flex items-center justify-center gap-2 rounded-2xl bg-background/25 py-2.5 text-sm font-semibold hover:bg-background/35">
+                  <Lightbulb className="h-4 w-4 text-accent" /> Publicação
+                </button>
+              </div>
+            </section>
+
+            {/* Stories */}
+            <section>
+              <p className="mb-2 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
+                <Flame className="h-3.5 w-3.5 text-accent" /> Stories
+              </p>
+              <div className="flex gap-4 overflow-x-auto pb-1">
+                {/* Meu story */}
+                {(() => {
+                  const meuGrupo = groupedStories.find(g => g.isMe);
+                  const hasStory = !!meuGrupo;
+                  const seen = hasStory ? meuGrupo.stories.every((s: StudyStory) => s.viewedByMe) : false;
+
+                  return (
+                    <div className="relative flex w-16 shrink-0 flex-col items-center gap-1.5">
+                      {/* Botão principal - clica no círculo abre story se existir */}
+                      <button
+                        onClick={() => {
+                          if (hasStory) {
+                            const idx = groupedStories.findIndex(g => g.isMe);
+                            if (idx >= 0) abrirStory(idx);
+                          } else {
+                            setCriando("escolher");
+                          }
+                        }}
+                        className="relative"
+                      >
+                        <span className={`relative ${hasStory ? "srx-ring" : "grid h-16 w-16 place-items-center rounded-full border-2 border-dashed border-border bg-surface"} `} data-seen={seen}>
+                          <UserAvatar
+                            fotoUrl={currentUserAvatar.fotoUrl}
+                            avatarTipo={currentUserAvatar.avatarTipo}
+                            avatarId={currentUserAvatar.avatarId}
+                            nome={currentUserAvatar.nome}
+                            className="h-[58px] w-[58px]"
+                          />
+                        </span>
+                      </button>
+
+                      {/* A4: Botão "+" SEMPRE abre modal de criar (irmão do botão, não filho) */}
+                      <button
+                        onClick={() => setCriando("escolher")}
+                        aria-label="Novo story"
+                        className="absolute -bottom-0.5 -right-0.5 grid h-5 w-5 place-items-center rounded-full border-2 border-background bg-accent text-xs font-bold text-accent-foreground"
+                      >
+                        +
+                      </button>
+
+                      <span className="text-[11px] text-muted-foreground">Seu story</span>
+                    </div>
+                  );
+                })()}
+
+                {/* Stories das amizades */}
+                {groupedStories.filter(g => !g.isMe).map((group) => (
+                  <button
+                    key={group.authorId}
+                    onClick={() => {
+                      const idx = groupedStories.findIndex(g => g.authorId === group.authorId);
+                      if (idx >= 0) abrirStory(idx);
+                    }}
+                    className="flex w-16 shrink-0 flex-col items-center gap-1.5"
+                  >
+                    <span className="srx-ring" data-seen={group.stories.every(s => s.viewedByMe)}>
+                      <UserAvatar
+                        fotoUrl={group.author.avatarUrl}
+                        avatarTipo={group.author.avatarTipo}
+                        avatarId={group.author.avatarId}
+                        nome={group.author.name}
+                        className="h-[58px] w-[58px]"
+                      />
+                    </span>
+                    <span className={`text-[11px] ${group.stories.every(s => s.viewedByMe) ? "text-muted-foreground" : "font-semibold text-foreground"}`}>
+                      {group.author.name}
+                    </span>
+                  </button>
+                ))}
+              </div>
+            </section>
+
+            {/* Filtros */}
+            <div className="flex gap-2 overflow-x-auto pb-1">
+              {filtros.map((f) => (
+                <button
+                  key={f}
+                  onClick={() => setFiltro(f)}
+                  className={`shrink-0 rounded-full px-3.5 py-1.5 text-xs font-semibold transition ${filtro === f ? "bg-foreground text-background" : "bg-surface text-muted-foreground hover:text-foreground"}`}
+                >
+                  {f}
+                </button>
+              ))}
+            </div>
+
+            {/* Feed Error - logo acima da lista */}
+            {feedError && (
+              <div className="p-3 rounded-xl bg-destructive/10 border border-destructive/20 text-sm text-destructive">
+                {feedError}
+                <button onClick={() => setFeedError(null)} className="ml-2 text-xs underline">Dispensar</button>
+              </div>
+            )}
+
+            {/* Feed */}
+            {loading ? (
+              <div className="space-y-4">
+                {[1, 2, 3].map(i => (
+                  <div key={i} className="srx-card animate-pulse h-48" />
+                ))}
+              </div>
+            ) : error ? (
+              <div className="srx-card p-6 text-center">
+                <p className="text-sm text-destructive mb-3">{error}</p>
+                <button onClick={refresh} className="text-sm font-semibold text-accent">Tentar de novo</button>
+              </div>
+            ) : posts.length === 0 ? (
+              <p className="py-10 text-center text-sm text-muted-foreground">Nada por aqui ainda. Que tal ser a primeira? ✨</p>
+            ) : (
+              <>
+                {posts.map((post) => (
+                  <PostCard
+                    key={post.id}
+                    post={post}
+                    onLike={handleLike}
+                    onSave={handleSave}
+                    onComment={handleComment}
+                    onDelete={handleDeletePost}
+                    onEdit={handleEditPost}
+                    currentUserId={getCachedUserId()}
+                    onOpenProfile={handleOpenProfile}
+                  />
+                ))}
+                <div ref={loadMoreRef} className="h-4" />
+                {loadingMore && <p className="py-4 text-center text-sm text-muted-foreground">Carregando mais…</p>}
+                {!hasMore && <p className="py-4 text-center text-xs text-muted-foreground">Você está em dia ✨ — volte mais tarde para ver novos registros.</p>}
+              </>
+            )}
+          </>
+        ) : (
+          // VIEW === "perfil"
+          <div className="space-y-4">
+            {perfilUserId !== null && (
+              <button
+                onClick={() => { setView("feed"); setPerfilUserId(null); }}
+                className="flex items-center gap-1.5 text-sm font-semibold text-accent hover:underline"
+              >
+                <ChevronLeft className="h-4 w-4" /> Voltar ao feed
+              </button>
+            )}
+            <StudyRatsPerfil
+              key={`${perfilUserId ?? "me"}-${perfilKey}`}
+              userId={perfilUserId ?? undefined}
+              onNovaPublicacao={() => setCriando("escolher")}
+            />
+          </div>
+        )}
+      </div>
+
+      {/* Lateral (desktop) - irmão direto da coluna do feed */}
+      {view === "feed" && (
+        <aside className="hidden lg:block">
+          <div className="sticky top-24 space-y-4">
+            {/* Seu dia */}
+            <div className="srx-card p-4">
+              <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Seu dia</p>
+              <p className="mt-1 text-2xl font-bold text-foreground">{fmtDuracao(minHoje) || "0min"}</p>
+              <p className="text-xs text-muted-foreground">estudadas hoje</p>
+              <button onClick={() => setCriando("checkin")} className="srx-fab mt-3 flex w-full items-center justify-center gap-2 rounded-full py-2 text-sm font-bold">
+                <CalendarCheck className="h-4 w-4" /> Fazer check-in
+              </button>
+            </div>
+
+            {/* Em alta na comunidade */}
+            {trendingPosts.length > 0 && (
+              <div className="srx-card p-4">
+                <p className="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Em alta na comunidade</p>
+                {trendingPosts.map((post, i) => (
+                  <p key={post.id} className="flex justify-between py-1 text-sm">
+                    <span className="font-semibold text-foreground">{post.title ?? post.caption?.slice(0, 30) ?? "Post"}</span>
+                    <span className="text-xs text-muted-foreground">{post.likesCount} curtidas</span>
+                  </p>
+                ))}
+              </div>
+            )}
+          </div>
+        </aside>
+      )}
+
+      {/* A2: Story Viewer usando fila fixa */}
+      {storyFila !== null && storyPos < storyFila.length && (
+        (() => {
+          const currentAuthorId = storyFila[storyPos];
+          const group = groupedStories.find(g => g.authorId === currentAuthorId);
+          if (!group) {
+            // Story expirou ou foi removido - avançar ou fechar
+            return null;
+          }
+          return (
+            <StoryViewer
+              key={group.authorId}
+              group={group}
+              groupIndex={storyPos}
+              totalGroups={storyFila.length}
+              onClose={() => { setStoryFila(null); setStoryPos(0); }}
+              onNextGroup={() => storyPos + 1 < storyFila.length ? setStoryPos(p => p + 1) : setStoryFila(null)}
+              onPrevGroup={() => storyPos > 0 ? setStoryPos(p => p - 1) : setStoryFila(null)}
+              markViewed={markStoryViewedHook}
+            />
+          );
+        })()
+      )}
+
+      {/* Modais */}
+      {(criando || editando) && (
+        <NovaPublicacaoModal
+          tipoInicial={criando === "escolher" || criando === null ? undefined : criando}
+          onClose={() => { setCriando(null); setEditando(null); }}
+          onPublicado={() => {
+            refresh();
+            refreshStories();
+            setPerfilKey(k => k + 1); // forçar recarregar o perfil
+          }}
+          editPost={editando}
+        />
+      )}
+
+      {comentando && postComentando && (
+        <ComentariosSheet
+          post={postComentando}
+          onClose={() => setComentando(null)}
+          onEnviar={async (texto) => {
+            await addComment(comentando, texto);
+            // Otimista: incrementar contador de comentários
+            updateCommentsCount(comentando, 1);
+            invalidateStudyFeedCache();
+          }}
+          onDeleteComment={(postId) => updateCommentsCount(postId, -1)}
+          currentUser={currentUserAvatar}
+        />
+      )}
+    </div>
+  );
+}
+
+// ============================================================
+// PostCard
+// ============================================================
+
+interface PostCardProps {
+  post: StudyPost;
+  onLike: (postId: string, onlyLike?: boolean) => void;
+  onSave: (postId: string) => void;
+  onComment: (postId: string) => void;
+  onDelete: (post: StudyPost) => void;
+  onEdit: (post: StudyPost) => void;
+  currentUserId: string | null;
+  onOpenProfile: (authorId: string) => void;
+}
+
+function PostCard({ post, onLike, onSave, onComment, onDelete, onEdit, currentUserId, onOpenProfile }: PostCardProps) {
+  const [idx, setIdx] = useState(0);
+  const [burst, setBurst] = useState(0);
+  const [menuOpen, setMenuOpen] = useState(false);
+  const ref = useRef<HTMLDivElement>(null);
+  const menuRef = useRef<HTMLDivElement>(null);
+  const isAuthor = post.author.id === currentUserId;
+
+  const duploToque = () => {
+    onLike(post.id, true);
+    setBurst((b) => b + 1);
+  };
+
+  // Fechar menu ao clicar fora
+  useEffect(() => {
+    const handleClickOutside = (e: MouseEvent) => {
+      if (menuRef.current && !menuRef.current.contains(e.target as Node)) {
+        setMenuOpen(false);
+      }
+    };
+    if (menuOpen) {
+      document.addEventListener("mousedown", handleClickOutside);
+    }
+    return () => document.removeEventListener("mousedown", handleClickOutside);
+  }, [menuOpen]);
+
+  return (
+    <article className="srx-card overflow-hidden">
+      <header className="flex items-center gap-3 p-3.5">
+        <button
+          onClick={() => onOpenProfile(post.author.id)}
+          className="srx-ring flex-shrink-0"
+          aria-label={`Ver perfil de ${post.author.name}`}
+        >
+          <UserAvatar
+            fotoUrl={post.author.avatarUrl}
+            avatarTipo={post.author.avatarTipo}
+            avatarId={post.author.avatarId}
+            nome={post.author.name}
+            className="h-9 w-9"
+          />
+        </button>
+        <div className="min-w-0 leading-tight">
+          <button
+            onClick={() => onOpenProfile(post.author.id)}
+            className="text-sm font-semibold text-foreground hover:underline"
+          >
+            {post.author.name}
+          </button>
+          <p className="text-xs text-muted-foreground">
+            {tempoRelativo(post.createdAt)} · {post.kind === "checkin" ? "Check-in" : post.category ? STUDY_RATS_CATEGORIAS.find(c => c.value === post.category)?.label ?? post.category : "Post"}
+          </p>
+        </div>
+        {isAuthor && (
+          <div className="relative" ref={menuRef}>
+            <button
+              aria-label="Mais opções"
+              className="srx-icon ml-auto text-muted-foreground"
+              onClick={() => setMenuOpen(!menuOpen)}
+            >
+              <MoreHorizontal className="h-5 w-5" />
+            </button>
+            {menuOpen && (
+              <div className="absolute right-0 top-full mt-1 z-10 srx-card rounded-xl shadow-lg border py-1 min-w-[140px]">
+                <button onClick={() => { onEdit(post); setMenuOpen(false); }} className="flex w-full items-center gap-2 px-3 py-2 text-sm text-foreground hover:bg-surface-2">
+                  Editar
+                </button>
+                <button onClick={() => { onDelete(post); setMenuOpen(false); }} className="flex w-full items-center gap-2 px-3 py-2 text-sm text-destructive hover:bg-surface-2">
+                  Excluir
+                </button>
+              </div>
+            )}
+          </div>
+        )}
+      </header>
+
+      {post.kind === "post" && (
+        <div className="relative mx-3.5 rounded-2xl bg-surface-2 p-4" onDoubleClick={duploToque}>
+          {post.category && (
+            <span className="srx-chip">
+              {STUDY_RATS_CATEGORIAS.find(c => c.value === post.category)?.emoji} {STUDY_RATS_CATEGORIAS.find(c => c.value === post.category)?.label}
+            </span>
+          )}
+          <p className="mt-2 text-base font-bold text-foreground">{post.title}</p>
+          <p className="mt-1 text-[15px] leading-relaxed text-foreground/90">{post.caption}</p>
+          {burst > 0 && post.photos.length === 0 && <div key={burst} className="srx-burst"><Heart className="h-16 w-16" fill="currentColor" /></div>}
+        </div>
+      )}
+
+      {post.photos.length > 0 && (
+        <div className={`relative ${post.kind === "post" ? "mx-3.5 mt-2 overflow-hidden rounded-2xl" : ""}`} onDoubleClick={duploToque}>
+          <div
+            ref={ref}
+            className="srx-scroll aspect-[4/5] bg-surface-2"
+            onScroll={(e) => setIdx(Math.round(e.currentTarget.scrollLeft / e.currentTarget.clientWidth))}
+          >
+            {post.photos.map((photo, i) => (
+              <div key={i} className="h-full w-full flex-shrink-0 flex items-center justify-center bg-surface-2">
+                {photo.url ? (
+                  <img
+                    src={photo.url}
+                    alt=""
+                    draggable={false}
+                    className="h-full w-full select-none object-cover"
+                    onError={(e) => { (e.target as HTMLImageElement).src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect fill='%23e5e7eb' width='100' height='100'/%3E%3Ctext x='50' y='55' dominant-baseline='middle' text-anchor='middle' font-size='12' fill='%239ca3af'%3EImagem%3C/text%3E%3C/svg%3E"; }}
+                  />
+                ) : (
+                  <div className="flex items-center justify-center h-full w-full bg-surface-2 text-muted-foreground">
+                    <Camera className="h-12 w-12" />
+                  </div>
+                )}
+              </div>
+            ))}
+          </div>
+          {post.kind === "checkin" && <span className="srx-badge absolute left-3 top-3"><CalendarCheck className="h-3.5 w-3.5 text-accent" /> Check-in · {fmtDuracao(post.durationMin)}</span>}
+          {post.photos.length > 1 && <span className="srx-badge absolute right-3 top-3">{idx + 1}/{post.photos.length}</span>}
+          {burst > 0 && <div key={burst} className="srx-burst"><Heart className="h-24 w-24" fill="currentColor" /></div>}
+        </div>
+      )}
+
+      <div className="flex items-center gap-4 px-3.5 pt-3 text-foreground">
+        <button
+          aria-label="Curtir"
+          onClick={() => onLike(post.id)}
+          className="srx-icon"
+        >
+          <Heart key={String(post.likedByMe)} className={`h-6 w-6 ${post.likedByMe ? "srx-liked" : ""}`} fill={post.likedByMe ? "currentColor" : "none"} />
+        </button>
+        <button aria-label="Comentar" onClick={() => onComment(post.id)} className="srx-icon">
+          <MessageCircle className="h-6 w-6" />
+        </button>
+        {post.photos.length > 1 && (
+          <div className="mx-auto flex gap-1">
+            {post.photos.map((_, i) => (
+              <span key={i} className="srx-dot" data-on={i === idx} />
+            ))}
+          </div>
+        )}
+        <button
+          aria-label="Salvar"
+          onClick={() => onSave(post.id)}
+          className={`srx-icon ${post.photos.length > 1 ? "" : "ml-auto"} ${post.savedByMe ? "srx-saved" : ""}`}
+        >
+          <Bookmark className="h-6 w-6" fill={post.savedByMe ? "currentColor" : "none"} />
+        </button>
+      </div>
+
+      <div className="space-y-1 px-3.5 pb-4 pt-2 text-sm">
+        <p className="text-foreground">
+          {post.likesCount === 0
+            ? "Seja a primeira a curtir"
+            : post.friendLikerId
+            ? <>Curtido por <b>{post.friendLikerName}</b>{post.likesCount > 1 && <> e <b>outras {post.likesCount - 1} pessoas</b></>}</>
+            : <><b>{post.likesCount}</b> curtida(s)</>}
+        </p>
+        {post.kind === "checkin" && (
+          <>
+            <p className="font-bold text-foreground">{post.title}</p>
+            {post.subject && (
+              <div><span className="srx-chip"><BookOpen className="h-3 w-3" /> {post.subject}</span></div>
+            )}
+            {post.caption && (
+              <p className="text-foreground/90"><b>{(post.author.name.split(" ")[0] ?? post.author.name).toLowerCase()}</b> {post.caption}</p>
+            )}
+          </>
+        )}
+        <button onClick={() => onComment(post.id)} className="text-muted-foreground">
+          {post.commentsCount > 0 ? `Ver todos os ${post.commentsCount} comentários` : "Adicionar um comentário…"}
+        </button>
+      </div>
+    </article>
+  );
+}
+
+// ============================================================
+// StoryViewer
+// ============================================================
+
+interface StoryViewerProps {
+  group: { authorId: string; stories: StudyStory[]; author: Omit<StudyAuthor, 'bio'>; isMe: boolean };
+  groupIndex: number;
+  totalGroups: number;
+  onClose: () => void;
+  onNextGroup: () => void;
+  onPrevGroup: () => void;
+  markViewed: (storyId: string) => Promise<void>;
+}
+
+function StoryViewer({ group, groupIndex, totalGroups, onClose, onNextGroup, onPrevGroup, markViewed }: StoryViewerProps) {
+  const [storyIndex, setStoryIndex] = useState(0);
+  const story = group.stories[storyIndex];
+
+  // Refs para callbacks estáveis no timer
+  const onNextGroupRef = useRef(onNextGroup);
+  const onPrevGroupRef = useRef(onPrevGroup);
+  onNextGroupRef.current = onNextGroup;
+  onPrevGroupRef.current = onPrevGroup;
+
+  // Auto-advance - timer reinicia apenas quando story.id muda
+  useEffect(() => {
+    if (!story) return;
+    const t = setTimeout(() => {
+      if (storyIndex + 1 < group.stories.length) {
+        setStoryIndex(i => i + 1);
+      } else {
+        onNextGroupRef.current();
+      }
+    }, 5000);
+    return () => clearTimeout(t);
+  }, [story?.id, storyIndex, group.stories.length]);
+
+  // Marcar como visto ao abrir
+  useEffect(() => {
+    if (story && !story.viewedByMe && !group.isMe) {
+      markViewed(story.id);
+    }
+  }, [story?.id, group.isMe, markViewed]);
+
+  if (!story) return null;
+
+  // Singular/plural para viewedCount
+  const viewedText = story.viewedCount === 1 ? "pessoa" : "pessoas";
+
+  return (
+    <div className="srx-overlay fixed inset-0 z-50 grid place-items-center p-4" onClick={onClose}>
+      <div className="srx-sheet relative aspect-[9/16] w-[min(100%,calc(min(88vh,760px)*0.5625))] overflow-hidden rounded-3xl bg-surface" onClick={(e) => e.stopPropagation()}>
+        {story.photoUrl ? (
+          <img src={story.photoUrl} alt="" className="absolute inset-0 h-full w-full object-cover" />
+        ) : (
+          <div className="srx-hero absolute inset-0 grid place-items-center !rounded-none p-8 text-center text-primary-foreground">
+            <div>
+              {story.category && (
+                <span className="srx-chip !bg-background/30">
+                  {STUDY_RATS_CATEGORIAS.find(c => c.value === story.category)?.emoji} {STUDY_RATS_CATEGORIAS.find(c => c.value === story.category)?.label}
+                </span>
+              )}
+              <p className="mt-4 text-2xl font-bold leading-snug">{story.text}</p>
+            </div>
+          </div>
+        )}
+
+        {/* Progress bars */}
+        <div className="absolute inset-x-0 top-0 space-y-3 bg-gradient-to-b from-background/80 to-transparent p-3">
+          <div className="flex gap-1">
+            {group.stories.map((_, i) => (
+              <div key={i} className="srx-progress flex-1">
+                {i < storyIndex ? <i style={{ animation: "none", width: "100%" }} /> : i === storyIndex ? <i key={story.id} /> : null}
+              </div>
+            ))}
+          </div>
+          <div className="flex items-center gap-2 text-sm text-foreground">
+            <UserAvatar
+              fotoUrl={group.author.avatarUrl}
+              avatarTipo={group.author.avatarTipo}
+              avatarId={group.author.avatarId}
+              nome={group.author.name}
+              className="h-8 w-8"
+            />
+            <b>{group.author.name}</b>
+            <span className="text-foreground/70">{tempoRelativo(story.createdAt)}</span>
+            <button aria-label="Fechar" onClick={onClose} className="ml-auto"><X className="h-5 w-5" /></button>
+          </div>
+        </div>
+
+        {/* Áreas de toque */}
+        <button aria-label="Anterior" onClick={() => storyIndex > 0 ? setStoryIndex(i => i - 1) : onPrevGroupRef.current()} className="absolute inset-y-0 left-0 w-1/3" />
+        <button aria-label="Próximo" onClick={() => storyIndex + 1 < group.stories.length ? setStoryIndex(i => i + 1) : onNextGroupRef.current()} className="absolute inset-y-0 right-0 w-1/3" />
+
+        {/* Info inferior */}
+        <div className="absolute inset-x-0 bottom-0 space-y-2 bg-gradient-to-t from-background/90 to-transparent p-4">
+          {story.kind !== "post" && story.durationMin > 0 && (
+            <span className="srx-badge"><Clock className="h-3.5 w-3.5 text-accent" /> {fmtDuracao(story.durationMin)} de {story.subject}</span>
+          )}
+          {story.photoUrl && story.text && <p className="text-sm font-semibold text-foreground">{story.text}</p>}
+          {group.isMe ? (
+            <p className="text-xs text-foreground/80">👁 Visto por {story.viewedCount} {viewedText} · some em 24h</p>
+          ) : (
+            <p className="text-xs text-foreground/80">{group.author.name}</p>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+// ============================================================
+// ComentariosSheet
+// ============================================================
+
+interface ComentariosSheetProps {
+  post: StudyPost;
+  onClose: () => void;
+  onEnviar: (texto: string) => Promise<void>;
+  onDeleteComment?: (postId: string) => void;
+  currentUser: { nome: string; fotoUrl: string | null; avatarTipo: string | null; avatarId: string | null };
+}
+
+function ComentariosSheet({ post, onClose, onEnviar, onDeleteComment, currentUser }: ComentariosSheetProps) {
+  const [texto, setTexto] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [comentarios, setComentarios] = useState<StudyComment[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const confirmDialog = useConfirm();
+
+  useEffect(() => {
+    let cancelled = false;
+    const loadComments = async () => {
+      try {
+        const data = await getComments(post.id);
+        if (!cancelled) setComentarios(data);
+      } catch (err) {
+        if (!cancelled) setError(studyRatsErrorMessage(err));
+      }
+    };
+    loadComments();
+    return () => { cancelled = true; };
+  }, [post.id]);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!texto.trim() || loading) return;
+    setLoading(true);
+    setError(null);
+    try {
+      await onEnviar(texto.trim());
+      setTexto("");
+      // Recarregar comentários
+      const data = await getComments(post.id);
+      setComentarios(data);
+    } catch (err) {
+      setError(studyRatsErrorMessage(err));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleDeleteComment = async (commentId: string) => {
+    const ok = await confirmDialog({
+      title: "Excluir comentário?",
+      confirmText: "Excluir",
+      destructive: true,
+    });
+    if (!ok) return;
+
+    setError(null);
+    try {
+      await deleteComment(commentId);
+      const data = await getComments(post.id);
+      setComentarios(data);
+      invalidateStudyFeedCache();
+      onDeleteComment?.(post.id);
+    } catch (err) {
+      setError(studyRatsErrorMessage(err));
+    }
+  };
+
+  return (
+    <div className="srx-overlay fixed inset-0 z-50 flex items-end justify-center sm:items-center" onClick={onClose}>
+      <div className="srx-sheet srx-card w-full max-w-md rounded-b-none p-4 sm:rounded-b-[1.5rem]" onClick={(e) => e.stopPropagation()}>
+        <div className="mx-auto mb-3 h-1 w-10 rounded-full bg-border" />
+        <h3 className="mb-3 text-center text-sm font-bold text-foreground">Comentários</h3>
+        <div className="max-h-[45vh] space-y-3 overflow-y-auto">
+          {comentarios.length === 0 && <p className="py-6 text-center text-sm text-muted-foreground">Ainda não há comentários. Seja a primeira! 💬</p>}
+          {comentarios.map((c) => (
+            <div key={c.id} className="flex gap-3">
+              <UserAvatar
+                fotoUrl={c.author.avatarUrl}
+                avatarTipo={c.author.avatarTipo}
+                avatarId={c.author.avatarId}
+                nome={c.author.name}
+                className="h-8 w-8"
+              />
+              <div className="flex-1 min-w-0">
+                <p className="text-sm text-foreground"><b>{c.author.name}</b> {c.text}</p>
+              </div>
+              {c.userId === getCachedUserId() && (
+                <button
+                  onClick={() => handleDeleteComment(c.id)}
+                  className="srx-icon text-muted-foreground"
+                  aria-label="Excluir comentário"
+                >
+                  <X className="h-5 w-5" />
+                </button>
+              )}
+            </div>
+          ))}
+        </div>
+        {error && (
+          <div className="mb-2 p-2 rounded-xl bg-destructive/10 border border-destructive/20 text-sm text-destructive">
+            {error}
+          </div>
+        )}
+        <div className="mt-3 flex gap-2 overflow-x-auto pb-1 text-xl">
+          {["🔥", "👏", "📚", "💪", "🙏", "❤️"].map((e) => (
+            <button key={e} onClick={() => setTexto((t) => t + e)} className="srx-icon">{e}</button>
+          ))}
+        </div>
+        <form className="mt-2 flex items-center gap-2" onSubmit={handleSubmit}>
+          <UserAvatar
+            fotoUrl={currentUser.fotoUrl}
+            avatarTipo={currentUser.avatarTipo}
+            avatarId={currentUser.avatarId}
+            nome={currentUser.nome}
+            className="h-8 w-8"
+          />
+          <input
+            value={texto}
+            onChange={(e) => setTexto(e.target.value)}
+            placeholder="Adicione um comentário…"
+            className="flex-1 rounded-full border border-input bg-background px-4 py-2 text-sm text-foreground"
+            disabled={loading}
+          />
+          <button
+            disabled={!texto.trim() || loading}
+            className="text-sm font-bold text-accent disabled:opacity-40"
+            type="submit"
+          >
+            {loading ? "Publicando…" : "Publicar"}
+          </button>
+        </form>
+      </div>
+    </div>
+  );
+}
\ No newline at end of file
diff --git a/src/components/study-rats/StudyRatsPerfil.tsx b/src/components/study-rats/StudyRatsPerfil.tsx
new file mode 100644
index 00000000..623aac1f
--- /dev/null
+++ b/src/components/study-rats/StudyRatsPerfil.tsx
@@ -0,0 +1,385 @@
+import { useEffect, useState } from "react";
+import { Bookmark, CalendarCheck, Clock, Heart, Lightbulb, MessageCircle, Plus, User, X } from "lucide-react";
+import { useStudyProfile } from "@/hooks/useStudyRats";
+import { updateBio, getProfilePosts, getSavedPosts, studyRatsErrorMessage } from "@/services/studyRatsService";
+import { loadFriendsOverview } from "@/services/friendService";
+import { STUDY_RATS, STUDY_RATS_CATEGORIAS } from "@/constants";
+import { fmtDuracao, tempoRelativo } from "@/utils/studyRatsFormat";
+import { UserAvatar } from "@/components/ui/UserAvatar";
+import { StudyRatsStyles } from "./StudyRatsStyles";
+import { useToast } from "@/hooks/useToast";
+import type { StudyPost } from "@/types/studyRats";
+
+interface StudyRatsPerfilProps {
+  /** ID do usuário cujo perfil está sendo visualizado. Se omitido, usa o usuário atual. */
+  userId?: string;
+  /** Callback ao clicar em "Nova publicação" (apenas no próprio perfil). */
+  onNovaPublicacao?: () => void;
+}
+
+export function StudyRatsPerfil({ userId, onNovaPublicacao }: StudyRatsPerfilProps) {
+  const { profile, loading, error, isMe, refresh } = useStudyProfile(userId);
+  const toast = useToast();
+
+  const [aba, setAba] = useState<"checkins" | "posts" | "salvos">("checkins");
+  const [bioEditando, setBioEditando] = useState(false);
+  const [bioValor, setBioValor] = useState("");
+  const [salvandoBio, setSalvandoBio] = useState(false);
+  const [aberto, setAberto] = useState<StudyPost | null>(null);
+
+  // Estados para carregamento do grid
+  const [gridPosts, setGridPosts] = useState<StudyPost[]>([]);
+  const [gridLoading, setGridLoading] = useState(false);
+  const [gridError, setGridError] = useState<string | null>(null);
+  const [gridReload, setGridReload] = useState(0);
+
+  // Amizades (apenas no próprio perfil)
+  const [amizadesCount, setAmizadesCount] = useState<number | null>(null);
+  const [amizadesError, setAmizadesError] = useState(false);
+
+  // Carregar posts do grid conforme a aba e o perfil
+  useEffect(() => {
+    if (!profile) return;
+
+    const cancelled = { current: false };
+    const targetId = profile.userId;
+
+    const carregar = async () => {
+      setGridLoading(true);
+      setGridError(null);
+      setGridPosts([]);
+
+      try {
+        let posts: StudyPost[] = [];
+        if (aba === "checkins") {
+          posts = await getProfilePosts(targetId, STUDY_RATS.TIPOS.CHECKIN);
+        } else if (aba === "posts") {
+          posts = await getProfilePosts(targetId, STUDY_RATS.TIPOS.POST);
+        } else if (aba === "salvos" && isMe) {
+          posts = await getSavedPosts();
+        }
+
+        if (!cancelled.current) {
+          setGridPosts(posts);
+        }
+      } catch (err) {
+        if (!cancelled.current) {
+          setGridError(studyRatsErrorMessage(err));
+        }
+      } finally {
+        if (!cancelled.current) {
+          setGridLoading(false);
+        }
+      }
+    };
+
+    carregar();
+
+    return () => {
+      cancelled.current = true;
+    };
+  }, [aba, profile?.userId, isMe, gridReload]);
+
+  // Carregar contagem de amizades (apenas no próprio perfil)
+  useEffect(() => {
+    if (!profile || !isMe) return;
+
+    const cancelled = { current: false };
+
+    loadFriendsOverview(profile.userId)
+      .then((overview) => {
+        if (!cancelled.current) {
+          const aceitas = overview.amigas?.length ?? 0;
+          setAmizadesCount(aceitas);
+        }
+      })
+      .catch(() => {
+        if (!cancelled.current) {
+          setAmizadesError(true);
+        }
+      });
+
+    return () => {
+      cancelled.current = true;
+    };
+  }, [profile?.userId, isMe]);
+
+  const handleSalvarBio = async () => {
+    if (!profile || salvandoBio) return;
+    const novaBio = bioValor.trim().slice(0, STUDY_RATS.LIMITES.MAX_BIO);
+    setSalvandoBio(true);
+    try {
+      await updateBio(novaBio);
+      setBioEditando(false);
+      refresh(); // recarrega perfil
+      toast.success("Bio atualizada");
+    } catch (err) {
+      const msg = err instanceof Error ? err.message : "Não foi possível salvar a bio.";
+      toast.error(msg);
+    } finally {
+      setSalvandoBio(false);
+    }
+  };
+
+  const handleCancelarBio = () => {
+    setBioValor(profile?.bio ?? "");
+    setBioEditando(false);
+  };
+
+  if (loading) {
+    return (
+      <div className="mx-auto max-w-[620px] space-y-5">
+        <StudyRatsStyles />
+        <div className="srx-card p-8 text-center">
+          <div className="animate-pulse space-y-3">
+            <div className="h-20 w-20 mx-auto rounded-full bg-surface-2" />
+            <div className="h-6 w-48 mx-auto bg-surface-2 rounded" />
+            <div className="h-4 w-64 mx-auto bg-surface-2 rounded" />
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  if (error || !profile) {
+    return (
+      <div className="mx-auto max-w-[620px] space-y-5">
+        <StudyRatsStyles />
+        <div className="srx-card p-8 text-center">
+          <User className="h-12 w-12 mx-auto text-muted-foreground mb-3" />
+          <p className="text-foreground">Perfil não encontrado</p>
+          <p className="text-sm text-muted-foreground mt-1">
+            {isMe ? "Tente recarregar a página." : "Este perfil não está acessível ou a amizade não foi aceita."}
+          </p>
+        </div>
+      </div>
+    );
+  }
+
+  const horas = Math.round(profile.hours);
+  const isOwnProfile = isMe;
+
+  return (
+    <div className="mx-auto max-w-[620px] space-y-5">
+      <StudyRatsStyles />
+
+      {/* Cabeçalho do perfil */}
+      <section className="flex items-center gap-5 sm:gap-8">
+        <span className="srx-ring shrink-0">
+          <UserAvatar
+            fotoUrl={profile.avatarUrl}
+            avatarTipo={profile.avatarTipo}
+            avatarId={profile.avatarId}
+            nome={profile.name}
+            className="h-20 w-20 sm:h-24 sm:w-24"
+          />
+        </span>
+        <div className={`grid flex-1 text-center ${isOwnProfile ? "grid-cols-3" : "grid-cols-2"}`}>
+          {[
+            [profile.postsCount, "publicações"],
+            [`${horas}h`, "estudadas"],
+            ...(isOwnProfile ? [[amizadesError ? "—" : amizadesCount ?? "—", "amizades"]] : []),
+          ].map(([v, l], idx) => (
+            <div key={`${l}-${idx}`}>
+              <p className="text-lg font-bold text-foreground">{v}</p>
+              <p className="text-xs text-muted-foreground">{l}</p>
+            </div>
+          ))}
+        </div>
+      </section>
+
+      {/* Nome, bio */}
+      <div className="space-y-1 text-sm">
+        <div className="flex items-center gap-2">
+          <p className="font-bold text-foreground">{profile.name}</p>
+        </div>
+        {!bioEditando && profile.bio && (
+          <p className="text-foreground/90 line-clamp-2">{profile.bio}</p>
+        )}
+        {!bioEditando && !profile.bio && isMe && (
+          <p className="text-muted-foreground text-sm">Sem bio ainda. Toque em "Editar perfil" para adicionar.</p>
+        )}
+        {bioEditando && isMe && (
+          <div className="flex items-center gap-2 flex-1">
+            <input
+              type="text"
+              value={bioValor}
+              onChange={(e) => setBioValor(e.target.value)}
+              maxLength={STUDY_RATS.LIMITES.MAX_BIO}
+              className="flex-1 rounded-xl border border-input bg-background px-3 py-1.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-accent"
+              placeholder="Sua bio..."
+            />
+            <span className="text-xs text-muted-foreground shrink-0">{bioValor.length}/{STUDY_RATS.LIMITES.MAX_BIO}</span>
+          </div>
+        )}
+        {bioEditando && isMe && (
+          <div className="flex gap-2">
+            <button
+              onClick={handleSalvarBio}
+              disabled={salvandoBio}
+              className="srx-fab flex items-center justify-center gap-1.5 rounded-xl py-2 text-sm font-bold"
+            >
+              {salvandoBio ? "Salvando..." : "Salvar"}
+            </button>
+            <button
+              onClick={handleCancelarBio}
+              disabled={salvandoBio}
+              className="flex-1 rounded-xl bg-surface-2 py-2 text-sm font-semibold text-foreground hover:bg-surface transition-colors"
+            >
+              Cancelar
+            </button>
+          </div>
+        )}
+        {/* Streak: não vem no RPC atual; reaproveitar do app-shell quando disponível */}
+      </div>
+
+      {/* Botões de ação (apenas no próprio perfil) */}
+      {isMe && (
+        <div className="flex gap-2">
+          <button
+            onClick={() => {
+              setBioValor(profile.bio ?? "");
+              setBioEditando(true);
+            }}
+            className="flex-1 rounded-xl bg-surface-2 py-2 text-sm font-semibold text-foreground hover:bg-surface transition-colors"
+          >
+            Editar perfil
+          </button>
+          <button
+            onClick={onNovaPublicacao}
+            className="srx-fab flex flex-1 items-center justify-center gap-1.5 rounded-xl py-2 text-sm font-bold"
+            disabled={!onNovaPublicacao}
+          >
+            <Plus className="h-4 w-4" /> Nova publicação
+          </button>
+        </div>
+      )}
+
+      {/* Abas do grid */}
+      <div className="flex border-t border-border">
+        {([
+          ["checkins", CalendarCheck, "Check-ins"],
+          ["posts", Lightbulb, "Publicações"],
+          ["salvos", Bookmark, "Salvos"],
+        ] as const).map(([k, I, l]) => {
+          const isSalvos = k === "salvos";
+          if (isSalvos && !isMe) return null; // esconder aba Salvos em perfil de outro
+          return (
+            <button
+              key={k}
+              onClick={() => setAba(k as "checkins" | "posts" | "salvos")}
+              className={`-mt-px flex flex-1 items-center justify-center gap-1.5 border-t-2 py-3 text-xs font-semibold uppercase tracking-wider ${aba === k ? "border-foreground text-foreground" : "border-transparent text-muted-foreground"}`}
+            >
+              <I className="h-4 w-4" /> {l}
+            </button>
+          );
+        })}
+      </div>
+
+      {/* Grid de 3 colunas */}
+      <div className="-mt-4 grid grid-cols-3 gap-0.5">
+        {(() => {
+          let items = gridPosts;
+
+          if (gridLoading) {
+            return (
+              <div className="col-span-3 py-10 text-center text-sm text-muted-foreground">
+                <div className="flex justify-center">
+                  <div className="h-6 w-6 animate-spin rounded-full border-2 border-accent border-t-transparent" />
+                </div>
+              </div>
+            );
+          }
+
+          if (gridError) {
+            return (
+              <div className="col-span-3 py-10 text-center text-sm text-destructive">
+                <p>{gridError}</p>
+                <button
+                  onClick={() => {
+                    setGridError(null);
+                    setGridLoading(true);
+                    setGridReload(n => n + 1);
+                  }}
+                  className="mt-2 text-sm font-semibold text-accent"
+                >
+                  Tentar de novo
+                </button>
+              </div>
+            );
+          }
+
+          if (items.length === 0) {
+            return (
+              <div className="col-span-3 py-10 text-center text-sm text-muted-foreground">
+                {aba === "checkins"
+                  ? "Nenhum check-in no feed ainda. Faça um check-in na Comunidade!"
+                  : aba === "posts"
+                    ? "Compartilhe dicas e curiosidades com a comunidade 💡"
+                    : "Publicações que você salvar no feed aparecem aqui (só você vê)."}
+              </div>
+            );
+          }
+
+          return items.map((p) => (
+            <button
+              key={p.id}
+              onClick={() => setAberto(p)}
+              className="srx-tile"
+            >
+              {p.photos[0]?.url ? (
+                <img src={p.photos[0].url} alt={p.title ?? ""} />
+              ) : (
+                <span className="flex h-full w-full items-center justify-center text-2xl bg-surface-2">
+                  {STUDY_RATS_CATEGORIAS.find((c) => c.value === p.category)?.emoji ?? "📸"}
+                </span>
+              )}
+              <span className="srx-badge absolute bottom-1 left-1 !px-1.5 !py-0.5 !text-[10px]">
+                <Clock className="h-2.5 w-2.5 text-accent" />{fmtDuracao(p.durationMin)}
+              </span>
+              <span className="srx-tile-info">
+                <Heart className="h-4 w-4" fill="currentColor" /> {p.likesCount}
+                <MessageCircle className="ml-2 h-4 w-4" fill="currentColor" /> {p.commentsCount}
+              </span>
+            </button>
+          ));
+        })()}
+      </div>
+
+      {/* Visualizador de publicação do feed (PostCard existente) */}
+      {aberto && (
+        <div className="srx-overlay fixed inset-0 z-50 grid place-items-center p-4" onClick={() => setAberto(null)}>
+          <div className="srx-sheet srx-card w-full max-w-sm overflow-hidden" onClick={(e) => e.stopPropagation()}>
+            <div className="relative">
+              {aberto.photos[0]?.url ? (
+                <img src={aberto.photos[0].url} alt="" className="aspect-[4/5] w-full object-cover" />
+              ) : (
+                <div className="aspect-[4/5] w-full flex items-center justify-center bg-surface-2">
+                  <span className="text-6xl">{STUDY_RATS_CATEGORIAS.find((c) => c.value === aberto.category)?.emoji ?? "📸"}</span>
+                </div>
+              )}
+              <button aria-label="Fechar" onClick={() => setAberto(null)} className="srx-badge absolute right-3 top-3">
+                <X className="h-4 w-4" />
+              </button>
+              {aberto.kind === "checkin" && (
+                <span className="srx-badge absolute left-3 top-3">
+                  <Clock className="h-3.5 w-3.5 text-accent" /> {fmtDuracao(aberto.durationMin)}
+                </span>
+              )}
+            </div>
+            <div className="space-y-1 p-4 text-sm">
+              <div className="flex gap-4 text-foreground"><Heart className="h-6 w-6" /><MessageCircle className="h-6 w-6" /></div>
+              <p className="font-bold text-foreground">{aberto.title}</p>
+              <p className="text-accent">
+                {aberto.kind === STUDY_RATS.TIPOS.CHECKIN
+                  ? aberto.subject
+                  : STUDY_RATS_CATEGORIAS.find((c) => c.value === aberto.category)?.label ?? "Post"}
+              </p>
+              <p className="text-muted-foreground">{tempoRelativo(aberto.createdAt)} · {aberto.kind === "checkin" ? (isOwnProfile ? "também no seu calendário" : "no feed") : "no feed"}</p>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
\ No newline at end of file
diff --git a/src/components/study-rats/StudyRatsStyles.tsx b/src/components/study-rats/StudyRatsStyles.tsx
new file mode 100644
index 00000000..35f460c9
--- /dev/null
+++ b/src/components/study-rats/StudyRatsStyles.tsx
@@ -0,0 +1,53 @@
+/** Estilos locais do Study Rats v4 — usa SOMENTE tokens do design system do Una Vox
+ *  (--surface, --surface-2, --border, --primary, --accent, --muted-foreground, --foreground, --background). */
+const CSS = `
+.srx-card { background: var(--surface); border: 1px solid var(--border); border-radius: 1.5rem; }
+.srx-hero { background: radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--primary) 85%, transparent), transparent 60%), linear-gradient(135deg, var(--primary), color-mix(in oklab, var(--primary) 55%, var(--background))); border-radius: 1.5rem; box-shadow: 0 20px 50px -25px var(--primary); }
+.srx-ring { padding: 2.5px; border-radius: 999px; background: conic-gradient(from 210deg, var(--accent), var(--primary), var(--accent)); }
+.srx-ring[data-seen="true"] { background: var(--border); }
+.srx-ring > * { border: 2.5px solid var(--background); border-radius: 999px; }
+.srx-chip { display:inline-flex; align-items:center; gap:.3rem; font-size:.72rem; font-weight:600; padding:.2rem .55rem; border-radius:999px; color: var(--accent); background: color-mix(in oklab, var(--accent) 14%, transparent); }
+.srx-badge { display:inline-flex; align-items:center; gap:.3rem; font-size:.72rem; font-weight:700; padding:.3rem .6rem; border-radius:999px; color: var(--foreground); background: color-mix(in oklab, var(--background) 65%, transparent); backdrop-filter: blur(8px); }
+.srx-scroll { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
+.srx-scroll::-webkit-scrollbar { display:none; }
+.srx-scroll > * { scroll-snap-align:center; flex: 0 0 100%; }
+.srx-dot { width:6px; height:6px; border-radius:999px; background: color-mix(in oklab, var(--foreground) 35%, transparent); transition: all .2s; }
+.srx-dot[data-on="true"] { width:16px; background: var(--accent); }
+.srx-icon { transition: transform .15s ease; }
+.srx-icon:hover { transform: scale(1.12); }
+.srx-icon:active { transform: scale(.9); }
+.srx-liked { color: var(--primary); animation: srx-pop .35s ease; }
+.srx-saved { color: var(--accent); }
+@keyframes srx-pop { 0%{transform:scale(1)} 40%{transform:scale(1.35)} 100%{transform:scale(1)} }
+.srx-burst { position:absolute; inset:0; display:grid; place-items:center; pointer-events:none; color: var(--foreground); filter: drop-shadow(0 6px 18px var(--primary)); animation: srx-burst .8s ease forwards; }
+@keyframes srx-burst { 0%{opacity:0; transform:scale(.3)} 25%{opacity:1; transform:scale(1.15)} 60%{opacity:1; transform:scale(1)} 100%{opacity:0; transform:scale(1.1)} }
+.srx-fab { background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 60%, var(--primary))); color: var(--accent-foreground); box-shadow: 0 12px 30px -10px var(--accent); }
+.srx-overlay { background: color-mix(in oklab, var(--background) 80%, transparent); backdrop-filter: blur(10px); animation: srx-fade .2s ease; }
+.srx-sheet { animation: srx-up .25s cubic-bezier(.2,.8,.2,1); }
+@keyframes srx-fade { from{opacity:0} } @keyframes srx-up { from{transform:translateY(24px); opacity:0} }
+.srx-progress { height:3px; border-radius:999px; background: color-mix(in oklab, var(--foreground) 30%, transparent); overflow:hidden; }
+.srx-progress > i { display:block; height:100%; background: var(--foreground); animation: srx-bar 5s linear forwards; }
+@keyframes srx-bar { from{width:0} to{width:100%} }
+.srx-day { border-radius: 999px; aspect-ratio: 1; display: grid; place-items: center; font-size: .85rem; position: relative; transition: transform .15s ease; }
+.srx-day:hover { transform: scale(1.06); }
+.srx-thumb { position:absolute; inset:3px; border-radius:999px; overflow:hidden; }
+.srx-thumb img { width:100%; height:100%; object-fit:cover; filter: brightness(.7); }
+.srx-thumb-num { position:absolute; inset:0; display:grid; place-items:center; font-weight:700; color: var(--foreground); text-shadow:0 1px 3px var(--background); }
+.srx-day[data-sel="true"] { box-shadow: 0 0 0 2px var(--accent); }
+.srx-count { position:absolute; right:2px; bottom:2px; min-width:16px; height:16px; padding:0 3px; border-radius:999px; font-size:.6rem; font-weight:700; display:grid; place-items:center; background: var(--accent); color: var(--accent-foreground); }
+.srx-tile { position:relative; aspect-ratio:1; overflow:hidden; background: var(--surface-2); }
+.srx-tile img { width:100%; height:100%; object-fit:cover; transition: transform .3s ease; }
+.srx-tile:hover img { transform: scale(1.06); }
+.srx-tile .srx-tile-info { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:.4rem; opacity:0; transition: opacity .2s; background: color-mix(in oklab, var(--background) 55%, transparent); color: var(--foreground); font-weight:700; font-size:.85rem; }
+.srx-tile:hover .srx-tile-info { opacity:1; }
+.srx-seg { background: var(--surface); border:1px solid var(--border); border-radius:999px; padding:3px; display:inline-flex; }
+.srx-seg button { border-radius:999px; padding:.35rem .8rem; font-size:.8rem; font-weight:600; color: var(--muted-foreground); display:inline-flex; align-items:center; gap:.35rem; }
+.srx-seg button[data-on="true"] { background: var(--accent); color: var(--accent-foreground); }
+
+/* Novos estilos para integração no Calendário (Fase 4) */
+.srx-thumb-loader { position:absolute; top:6px; right:6px; }
+.srx-thumb-placeholder { position:absolute; top:6px; right:6px; }
+`;
+export function StudyRatsStyles() {
+  return <style href="study-rats-styles" precedence="default">{CSS}</style>;
+}
diff --git a/src/constants/index.ts b/src/constants/index.ts
index a6751974..e7afbb6e 100644
--- a/src/constants/index.ts
