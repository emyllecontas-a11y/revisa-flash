+                            {i < previews.length - 1 && <button onClick={() => moverFoto(i, i + 1)} className="srx-icon p-1 bg-background/80 rounded-full" aria-label="Mover para a direita"><ChevronRight className="h-3.5 w-3.5" /></button>}
