+++ b/src/types/studyRats.ts
@@ -0,0 +1,202 @@
+// src/types/studyRats.ts
+// Tipos do Study Rats (feed estilo Instagram da aba Comunidade).
+// Os nomes seguem o padrão camelCase do TypeScript; o serviço converte para/de
+// snake_case nas tabelas e RPCs do Supabase (supabase/migrations/20261124120000_study_rats.sql).
+
+export type StudyPostKind = 'checkin' | 'post';
+
+export type StudyCategory = 'study_tip' | 'curiosity' | 'question' | 'motivation';
+
+export type StudyDestination = 'feed' | 'story';
+
+export interface StudyAuthor {
+  id: string;
+  name: string;
+  avatarUrl: string | null;
+  avatarTipo: string | null;
+  avatarId: string | null;
+  bio: string | null;
+}
+
+export interface StudyPhoto {
+  id: string;
+  path: string;
+  position: number;
+  url: string | null;
+}
+
+export interface StudyPost {
+  id: string;
+  userId: string;
+  kind: StudyPostKind;
+  category: StudyCategory | null;
+  title: string | null;
+  caption: string | null;
+  subject: string | null;
+  durationMin: number;
+  studyDate: string | null;
+  studyTime: string | null;
+  inFeed: boolean;
+  createdAt: string;
+  author: StudyAuthor;
+  likesCount: number;
+  commentsCount: number;
+  likedByMe: boolean;
+  savedByMe: boolean;
+  friendLikerId: string | null;
+  friendLikerName: string | null;
+  photos: StudyPhoto[];
+}
+
+export interface StudyComment {
+  id: string;
+  postId: string;
+  userId: string;
+  text: string;
+  createdAt: string;
+  author: Omit<StudyAuthor, 'bio'>;
+}
+
+export interface StudyStory {
+  id: string;
+  userId: string;
+  kind: StudyPostKind;
+  category: StudyCategory | null;
+  text: string | null;
+  photoPath: string | null;
+  photoUrl: string | null;
+  subject: string | null;
+  durationMin: number;
+  checkinPostId: string | null;
+  createdAt: string;
+  expiresAt: string;
+  viewedByMe: boolean;
+  viewedCount: number;
+  author: Omit<StudyAuthor, 'bio'>;
+}
+
+export interface StudyStoryViewer {
+  userId: string;
+  viewedAt: string;
+  name: string;
+  avatarUrl: string | null;
+  avatarTipo: string | null;
+  avatarId: string | null;
+}
+
+export interface StudyProfileStats {
+  userId: string;
+  name: string;
+  bio: string | null;
+  avatarUrl: string | null;
+  avatarTipo: string | null;
+  avatarId: string | null;
+  postsCount: number;
+  hours: number;
+}
+
+export interface StudyCalendarPhoto {
+  path: string;
+  position: number;
+  url: string | null;
+}
+
+export interface StudyCalendarEntry {
+  id: string;
+  studyDate: string;
+  studyTime: string | null;
+  subject: string | null;
+  durationMin: number;
+  title: string | null;
+  caption: string | null;
+  inFeed: boolean;
+  createdAt: string;
+  photos: StudyCalendarPhoto[];
+}
+
+export interface StudyFeedFilter {
+  kind?: StudyPostKind;
+  category?: StudyCategory;
+  authorId?: string;
+  savedOnly?: boolean;
+}
+
+export interface StudyFeedCursor {
+  createdAt: string;
+  id: string;
+}
+
+export interface StudyFeedPage {
+  posts: StudyPost[];
+  nextCursor: StudyFeedCursor | null;
+}
+
+export interface StudyFeedParams {
+  cursor?: StudyFeedCursor | null;
+  filter?: StudyFeedFilter;
+  pageSize?: number;
+}
+
+export interface CreateStudyPostInput {
+  destination: StudyDestination;
+  kind: StudyPostKind;
+  category?: StudyCategory | null;
+  files?: File[];
+  title?: string;
+  subject?: string;
+  durationMin?: number;
+  caption?: string;
+  /** Data local (YYYY-MM-DD). Se omitida, usa a data local de hoje. */
+  studyDate?: string;
+}
+
+export interface CreatedStudyPost {
+  postId: string | null;
+  storyId: string | null;
+  photos: StudyPhoto[];
+  /** Título como foi gravado pelo servidor (null quando não houve post). */
+  title: string | null;
+  /** Data local (YYYY-MM-DD) gravada pelo servidor; null fora de check-in. */
+  studyDate: string | null;
+  /** Hora local gravada pelo servidor; null fora de check-in. */
+  studyTime: string | null;
+  /** Duração gravada pelo servidor (0 fora de check-in). */
+  durationMin: number;
+}
+
+export interface UpdateStudyPostInput {
+  title?: string;
+  caption?: string;
+  category?: StudyCategory | null;
+  subject?: string;
+  durationMin?: number;
+}
+
+// ------------------------------------------------------------------
+// Documento local (RxDB) — cache de LEITURA dos check-ins da usuária.
+// Nunca é enviado ao Supabase pelo sync: as escritas passam pelo serviço.
+// ------------------------------------------------------------------
+
+export interface StudyCheckinPhoto {
+  id: string;
+  path: string;
+  position: number;
+}
+
+export interface StudyCheckinRecord {
+  id: string;
+  user_id: string;
+  kind: 'checkin';
+  category: StudyCategory | null;
+  title: string | null;
+  caption: string | null;
+  subject: string | null;
+  duration_min: number;
+  study_date: string;
+  study_time: string | null;
+  in_feed: boolean;
+  created_at: string;
+  updated_at: string;
+  isDeleted: boolean;
+  photos: StudyCheckinPhoto[];
+}
diff --git a/src/utils/date.ts b/src/utils/date.ts
new file mode 100644
index 00000000..6c811cec
--- /dev/null
+++ b/src/utils/date.ts
@@ -0,0 +1,36 @@
+// src/utils/date.ts
+// Datas locais do Study Rats (America/Fortaleza no dispositivo da usuária).
+// NUNCA usar toISOString() aqui: ele converte para UTC e pode voltar um dia.
+
+function pad2(n: number): string {
+  return String(n).padStart(2, '0');
+}
+
+/** Data local no formato YYYY-MM-DD (com zero à esquerda). */
+export function localDateStr(date: Date = new Date()): string {
+  return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
+}
+
+/** Hora local no formato HH:MM:SS (aceito pela coluna study_time). */
+export function localTimeStr(date: Date = new Date()): string {
+  return `${pad2(date.getHours())}:${pad2(date.getMinutes())}:${pad2(date.getSeconds())}`;
+}
+
+/** Primeiro e último dia (YYYY-MM-DD) de um mês local. `month` vai de 1 a 12. */
+export function localMonthRange(year: number, month: number): { start: string; end: string } {
+  const lastDay = new Date(year, month, 0).getDate();
+  return {
+    start: `${year}-${pad2(month)}-01`,
+    end: `${year}-${pad2(month)}-${pad2(lastDay)}`,
+  };
+}
+
+/** Prefixo YYYY-MM-DD de um mês local, para comparações de string. `month` de 1 a 12. */
+export function localMonthPrefix(year: number, month: number): string {
+  return `${year}-${pad2(month)}-`;
+}
+
+/** O dia `dateStr` (YYYY-MM-DD) pertence ao mês local informado? */
+export function isDateInMonth(dateStr: string | null | undefined, year: number, month: number): boolean {
+  return typeof dateStr === 'string' && dateStr.startsWith(localMonthPrefix(year, month));
+}
diff --git a/src/utils/studyRatsFormat.ts b/src/utils/studyRatsFormat.ts
new file mode 100644
index 00000000..a1883893
--- /dev/null
+++ b/src/utils/studyRatsFormat.ts
@@ -0,0 +1,31 @@
+// src/utils/studyRatsFormat.ts
+// Formatações visíveis do Study Rats (movidas do protótipo mock-data.ts).
+
+/** 90 -> "1h30min" | 60 -> "1h" | 45 -> "45min". */
+export function fmtDuracao(min: number): string {
+  const total = Number.isFinite(min) ? Math.max(0, Math.round(min)) : 0;
+  if (total < 60) return `${total}min`;
+  const horas = Math.floor(total / 60);
+  const resto = total % 60;
+  return resto ? `${horas}h${String(resto).padStart(2, '0')}min` : `${horas}h`;
+}
+
+/** "agora", "há 3h", "há 2d"… a partir da data/hora atual do dispositivo. */
+export function tempoRelativo(iso: string, agora: Date = new Date()): string {
+  const alvo = new Date(iso);
+  if (Number.isNaN(alvo.getTime())) return '';
+
+  const diffMs = agora.getTime() - alvo.getTime();
+  if (diffMs < 60_000) return 'agora';
+
+  const minutos = Math.floor(diffMs / 60_000);
+  if (minutos < 60) return `há ${minutos}min`;
+
+  const horas = Math.floor(minutos / 60);
+  if (horas < 24) return `há ${horas}h`;
+
+  const dias = Math.floor(horas / 24);
+  if (dias < 7) return `há ${dias}d`;
+
+  return alvo.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
+}
