diff --git a/src/components/study-rats/CheckinDayThumb.tsx b/src/components/study-rats/CheckinDayThumb.tsx
new file mode 100644
index 00000000..f3b9f50b
--- /dev/null
+++ b/src/components/study-rats/CheckinDayThumb.tsx
@@ -0,0 +1,44 @@
+import { Loader2 } from "lucide-react";
+import type { StudyCalendarEntry } from "@/types/studyRats";
+
+interface CheckinDayThumbProps {
+  checkins: StudyCalendarEntry[];
+  firstPhotoUrl: string | null;
+  loading: boolean;
+}
+
+export function CheckinDayThumb({ checkins, firstPhotoUrl, loading }: CheckinDayThumbProps) {
+  const count = checkins.length;
+  const hasMultiple = count > 1;
+
+  if (loading) {
+    return (
+      <span className="srx-thumb-loader absolute top-1.5 right-1.5 h-5 w-5 sm:h-7 sm:w-7 rounded-full border-2 border-accent/30 border-t-accent animate-spin" aria-hidden="true" />
+    );
+  }
+
+  if (firstPhotoUrl) {
+    return (
+      <>
+        <span className="srx-thumb absolute top-1.5 right-1.5 h-5 w-5 sm:h-7 sm:w-7 rounded-full overflow-hidden ring-2 ring-background bg-surface-2">
+          <img src={firstPhotoUrl} alt="" className="h-full w-full object-cover" />
+        </span>
+        {hasMultiple && (
+          <span className="srx-count absolute bottom-0.5 right-0.5 min-w-[14px] h-4 rounded-full px-1 text-[9px] font-bold text-center bg-accent text-accent-foreground">
+            {count}
+          </span>
+        )}
+      </>
+    );
+  }
+
+  // Sem foto: círculo simples com inicial da matéria ou ícone
+  const first = checkins[0];
+  const initial = first?.subject?.charAt(0).toUpperCase() ?? "📚";
+
+  return (
+    <span className="srx-thumb-placeholder absolute top-1.5 right-1.5 h-5 w-5 sm:h-7 sm:w-7 rounded-full flex items-center justify-center text-[10px] font-bold bg-surface-2 ring-1 ring-border">
+      {initial}
+    </span>
+  );
+}
\ No newline at end of file
diff --git a/src/components/study-rats/CheckinDetailViewer.tsx b/src/components/study-rats/CheckinDetailViewer.tsx
new file mode 100644
index 00000000..9679fc56
--- /dev/null
+++ b/src/components/study-rats/CheckinDetailViewer.tsx
@@ -0,0 +1,136 @@
+import { useEffect, useState } from "react";
+import { X, Clock, ChevronLeft, ChevronRight } from "lucide-react";
+import { fmtDuracao } from "@/utils/studyRatsFormat";
+import type { StudyCalendarEntry } from "@/types/studyRats";
+
+interface CheckinDetailViewerProps {
+  checkin: StudyCalendarEntry | null;
+  onClose: () => void;
+  onPrev?: () => void;
+  onNext?: () => void;
+  hasPrev?: boolean;
+  hasNext?: boolean;
+}
+
+export function CheckinDetailViewer({
+  checkin,
+  onClose,
+  onPrev,
+  onNext,
+  hasPrev,
+  hasNext,
+}: CheckinDetailViewerProps) {
+  const [idx, setIdx] = useState(0);
+
+  const photos = checkin?.photos?.filter((p) => p.url) ?? [];
+
+  // Zerar idx ao trocar de check-in
+  useEffect(() => {
+    setIdx(0);
+  }, [checkin?.id]);
+
+  useEffect(() => {
+    const handleKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") onClose();
+      if (e.key === "ArrowLeft" && hasPrev) onPrev?.();
+      if (e.key === "ArrowRight" && hasNext) onNext?.();
+    };
+    window.addEventListener("keydown", handleKey);
+    return () => window.removeEventListener("keydown", handleKey);
+  }, [onClose, onPrev, onNext, hasPrev, hasNext]);
+
+  const goPrev = () => {
+    if (photos.length > 1) {
+      setIdx((i) => (i - 1 + photos.length) % photos.length);
+    } else if (hasPrev) {
+      onPrev?.();
+    }
+  };
+
+  const goNext = () => {
+    if (photos.length > 1) {
+      setIdx((i) => (i + 1) % photos.length);
+    } else if (hasNext) {
+      onNext?.();
+    }
+  };
+
+  if (!checkin) return null;
+
+  const currentPhoto = photos[idx];
+
+  return (
+    <div className="srx-overlay fixed inset-0 z-50 grid place-items-center p-4" onClick={onClose}>
+      <div className="srx-sheet srx-card w-full max-w-sm overflow-hidden" onClick={(e) => e.stopPropagation()}>
+        <div className="relative">
+          {photos.length > 0 ? (
+            <>
+              <div
+                className="aspect-[4/5] w-full overflow-hidden bg-surface-2"
+                onClick={(e) => {
+                  e.stopPropagation();
+                  const rect = e.currentTarget.getBoundingClientRect();
+                  if (e.clientX < rect.left + rect.width / 2) goPrev();
+                  else goNext();
+                }}
+              >
+                {currentPhoto?.url ? (
+                  <img
+                    src={currentPhoto.url}
+                    alt={checkin.title ?? ""}
+                    className="h-full w-full object-cover transition-transform duration-100"
+                  />
+                ) : (
+                  <div className="flex h-full w-full items-center justify-center bg-surface-2">
+                    <span className="text-6xl">{checkin.subject?.charAt(0).toUpperCase() ?? "📚"}</span>
+                  </div>
+                )}
+              </div>
+              {photos.length > 1 && (
+                <>
+                  <button
+                    onClick={(e) => { e.stopPropagation(); goPrev(); }}
+                    className="absolute left-2 top-1/2 -translate-y-1/2 grid h-8 w-8 place-items-center rounded-full bg-background/80 text-foreground hover:bg-background"
+                    aria-label="Anterior"
+                  >
+                    <ChevronLeft className="h-5 w-5" />
+                  </button>
+                  <button
+                    onClick={(e) => { e.stopPropagation(); goNext(); }}
+                    className="absolute right-2 top-1/2 -translate-y-1/2 grid h-8 w-8 place-items-center rounded-full bg-background/80 text-foreground hover:bg-background"
+                    aria-label="Próxima"
+                  >
+                    <ChevronRight className="h-5 w-5" />
+                  </button>
+                </>
+              )}
+            </>
+          ) : (
+            <div className="aspect-[4/5] w-full flex items-center justify-center bg-surface-2">
+              <span className="text-6xl">{checkin.subject?.charAt(0).toUpperCase() ?? "📚"}</span>
+            </div>
+          )}
+
+          <button
+            aria-label="Fechar"
+            onClick={onClose}
+            className="srx-badge absolute right-3 top-3"
+          >
+            <X className="h-4 w-4" />
+          </button>
+          <span className="srx-badge absolute left-3 top-3">
+            <Clock className="h-3.5 w-3.5 text-accent" /> {fmtDuracao(checkin.durationMin)}
+          </span>
+        </div>
+        <div className="p-4 space-y-1 text-sm">
+          <p className="font-bold text-foreground">{checkin.title ?? `Check-in de ${checkin.subject}`}</p>
+          <p className="text-accent">{checkin.subject}</p>
+          <p className="flex items-center gap-1 text-muted-foreground">
+            <Clock className="h-3 w-3" /> {checkin.studyTime ?? "—"} · {fmtDuracao(checkin.durationMin)}
+          </p>
+          {checkin.caption && <p className="text-foreground/90">{checkin.caption}</p>}
+        </div>
+      </div>
+    </div>
+  );
+}
\ No newline at end of file
diff --git a/src/components/study-rats/IMPLEMENTATION_GUIDE.md b/src/components/study-rats/IMPLEMENTATION_GUIDE.md
new file mode 100644
index 00000000..e724ae0b
--- /dev/null
+++ b/src/components/study-rats/IMPLEMENTATION_GUIDE.md
@@ -0,0 +1,51 @@
+# Prompt para a IA (Qwen Code) — implementar a parte funcional do Study Rats v7
+
+Você vai tornar funcional o protótipo visual em `src/components/study-rats/` (copiado da pasta `study-rats/`).
+
+## Antes de tudo
+1. **Analise o código antes de alterar qualquer coisa**: `src/routes/comunidade.tsx`, `src/routes/calendario.tsx`, `src/contexts/UserContext`, `src/services/friendService`, `src/lib/db` (RxDB) e como o app já faz upload de imagens (relatórios `RELATORIO_1A*_FLASHCARD_IMAGENS.txt` e policies de storage).
+2. Siga os padrões existentes (serviços, sincronização, storage). Não refatore outras áreas.
+3. **Não duplique** grupos, ranking, estatísticas, desempenho ou conquistas — use os que já existem (ex.: "dias seguidos" vem da sequência atual do app, se houver).
+4. **Mantenha 100% do visual** dos componentes v4 (classes `srx-*`, animações, layout). Troque apenas os dados falsos por reais.
+5. **Mobile e desktop**: mantenha os dois layouts do protótipo (barra inferior no celular abaixo de 768px; coluna lateral no feed a partir de 1024px). Se o app já tiver barra inferior própria, integre o botão "+" nela em vez de duplicar.
+6. Confira se o Una Vox tem os tokens `--surface`, `--surface-2` e `--accent` (laranja). Se o nome for outro, mapeie em `StudyRatsStyles.tsx` sem mudar o resto.
+
+## Integração
+- Comunidade: nova aba `studyrats` no `BotaoTab` (mesma lógica de `?tab=`), renderizando `<StudyRatsFeed />`.
+- Dentro de Study Rats há o seletor **Feed / Meu perfil** (já embutido em `StudyRatsFeed`).
+- Calendários: `<StudyRatsCalendario onIrParaComunidade={...} />` — o botão leva para `/comunidade?tab=studyrats`.
+- **Regra central: só se publica pela Comunidade** (feed ou perfil). O calendário NÃO cria registros; ele apenas lê as publicações da própria usuária.
+
+## Dados necessários
+- `study_posts`: id, user_id, **tipo** (`checkin` | `post`), **categoria** (`Dica de estudo` | `Curiosidade` | `Dúvida` | `Motivação`, só para `post`), titulo, legenda, materia (opcional em `post`), duracao_min (só `checkin`), data_estudo (date), hora (time), created_at.
+  - Validação: `checkin` exige ao menos 1 foto, matéria e duração > 0; `post` exige texto e categoria.
+- `study_post_photos`: id, post_id, foto_path, ordem (carrossel, até 10 fotos).
+- `study_post_likes`: post_id, user_id (único por par).
+- `study_post_comments`: id, post_id, user_id, texto, created_at.
+- `study_post_saves`: post_id, user_id (único por par) — só a própria usuária vê.
+- `study_stories`: id, user_id, tipo (`checkin` | `post`), categoria, texto, foto_path (opcional para story de texto), materia, duracao_min, post_checkin_id (opcional, liga ao check-in salvo), created_at, expira_em (created_at + 24h).
+  - Consultas de stories filtram `expira_em > agora`. Apagar/arquivar expirados com a rotina agendada que o app já usar (ou limpar na leitura).
+- `study_story_views`: story_id, user_id — para o anel "visto".
+- Fotos no storage existente (bucket próprio, ex. `study-rats`), leitura liberada para amizades da autora.
+- Um registro do calendário = um **check-in** da própria usuária (filtrar `study_posts` por `user_id`, `tipo = checkin` e mês). Publicações normais nunca entram no calendário nem nas horas estudadas.
+
+## Funcionalidades
+1. **Feed**: check-ins e publicações da usuária e das amizades (`friendService`), mais recentes primeiro, paginação infinita. Filtros por tipo/categoria. Publicações de texto usam o cartão de texto (chip da categoria + título + texto); check-ins usam o cartão de foto com selo "Check-in · tempo". "Curtido por" mostra uma amizade que curtiu + total.
+2. **Stories**: da usuária (primeiro, em "Seu story") e das amizades, só os não expirados (24h); ordem: não vistos primeiro. Abrir marca como visto. Avança sozinho a cada 5s, toque esquerdo/direito volta/avança. "Seu story" cria um story.
+3. **Carrossel**: várias fotos por publicação, em ordem; contador 1/N e pontinhos.
+4. **Curtir**: botão alterna; duplo toque na foto só curte (nunca descurte) e mostra o coração animado. Atualização otimista com contador.
+5. **Comentários**: painel inferior, lista em ordem cronológica, enviar com Enter ou "Publicar", atalhos de emoji.
+6. **Salvar**: alterna `study_post_saves`.
+7. **Compartilhar**: usar o compartilhamento já existente do app ("Compartilhado comigo") se houver; senão, deixar o botão sem ação.
+8. **Perfil do estudante** — abas Check-ins (grade), Publicações (lista de cartões) e Salvos. (`StudyRatsPerfil`): dados do `UserContext` (nome, foto, bio editável), nº de publicações, nº de amizades (`friendService`), horas (soma de `duracao_min`); grade 3 colunas com todas as publicações da usuária (mais recentes primeiro); aba Salvos lista `study_post_saves`. Ao abrir o perfil de uma amizade, esconder "Editar perfil", "Nova publicação" e Salvos.
+9. **Criar** (`NovaPublicacaoModal`): primeiro passo escolhe o tipo; depois o **destino** (`feed` = permanente em `study_posts`; `story` = `study_stories` com 24h). Regra: check-in com destino `story` também grava o registro do check-in (para o calendário e as horas), mas não aparece no feed nem na grade do perfil; publicação normal em story não grava nada permanente. (ou vem de `tipoInicial`). Trocar `studyRatsStore.publicar` pelo serviço real: `publicar({ destino, tipo, categoria, arquivos, materia, duracaoMin, legenda, data })`. Matérias vêm das matérias da usuária no app. Data = hoje. Aparece no feed, no perfil e no calendário (mesma tabela, sem duplicar dados).
+10. **Calendário** (somente leitura): foto do 1º registro do dia no círculo, contador quando houver mais de um, painel do dia selecionado (sem botão de criar), setas trocam o mês, resumo com total de registros, horas (soma de `duracao_min`) e dias seguidos.
+11. Só a autora pode excluir/editar a própria publicação (menu "…").
+
+## Componentes
+- `StudyRatsFeed` (trocar `PUBLICACOES` e `STORIES` por consultas reais)
+- `NovaPublicacaoModal` (adicionar `onSubmit`, upload múltiplo)
+- `StudyRatsPerfil` (trocar `REGISTROS` pelas publicações da usuária)
+- `StudyRatsCalendario` (trocar `REGISTROS` por consulta real)
+- Manter o teste `study-rats-store.test.ts` adaptado ao serviço real (check-in vai ao calendário; publicação não).
+- `StudyRatsStyles` (manter), `mock-data.ts` e `fotos-exemplo/` (remover ao final; manter `fmtDuracao` e `tempoRelativo` em um utilitário)
diff --git a/src/components/study-rats/NovaPublicacaoModal.tsx b/src/components/study-rats/NovaPublicacaoModal.tsx
new file mode 100644
index 00000000..56094777
--- /dev/null
+++ b/src/components/study-rats/NovaPublicacaoModal.tsx
@@ -0,0 +1,684 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { CalendarCheck, Camera, ChevronLeft, ChevronRight, Clock, Lightbulb, Loader2, RotateCcw, X } from "lucide-react";
+import { useStudyRatsCheckins } from "@/contexts/StudyRatsContext";
+import { getDisciplines } from "@/lib/supabaseClient";
+import { createPost, updatePost } from "@/services/studyRatsService";
+import { invalidateStudyFeedCache } from "@/hooks/useStudyRats";
+import { STUDY_RATS } from "@/constants";
+import { fmtDuracao } from "@/utils/studyRatsFormat";
+import { uid } from "@/utils/helpers";
+import type { StudyPost } from "@/types/studyRats";
+
+type TipoPublicacao = "checkin" | "post";
+type Destino = "feed" | "story";
+type Categoria = "study_tip" | "curiosity" | "question" | "motivation";
+
+interface NovaPublicacaoModalProps {
+  onClose: () => void;
+  onPublicado?: () => void;
+  tipoInicial?: TipoPublicacao | "escolher";
+  editPost?: StudyPost | null;
+}
+
+interface Disciplina {
+  id: string;
+  name: string;
+  user_id: string;
+  created_at: string;
+  isdeleted: boolean;
+}
+
+export function NovaPublicacaoModal({ onClose, onPublicado, tipoInicial, editPost }: NovaPublicacaoModalProps) {
+  const isEditing = !!editPost;
+  const [tipo, setTipo] = useState<TipoPublicacao | "escolher" | undefined>(isEditing ? editPost?.kind : (tipoInicial === "escolher" ? undefined : tipoInicial));
+  const [fotos, setFotos] = useState<File[]>([]);
+  const [previews, setPreviews] = useState<string[]>([]);
+  const [materia, setMateria] = useState<string>(isEditing && editPost?.kind === "checkin" ? editPost?.subject ?? "" : "");
+  const [categoria, setCategoria] = useState<Categoria>(isEditing && editPost?.kind === "post" ? (editPost?.category as Categoria) : "study_tip");
+  const [duracao, setDuracao] = useState(isEditing && editPost?.kind === "checkin" ? editPost?.durationMin : 60);
+  const [legenda, setLegenda] = useState(isEditing ? (editPost?.caption ?? "") : "");
+  const [destino, setDestino] = useState<Destino>(isEditing ? (editPost?.inFeed ? "feed" : "story") : "feed");
+  const [disciplinas, setDisciplinas] = useState<Disciplina[]>([]);
+  const [loadingDisciplinas, setLoadingDisciplinas] = useState(true);
+  const [publicando, setPublicando] = useState(false);
+  const [erro, setErro] = useState<string | null>(null);
+  const [mostrarCamera, setMostrarCamera] = useState(false);
+  const [cameraStream, setCameraStream] = useState<MediaStream | null>(null);
+  const [cameraFacingMode, setCameraFacingMode] = useState<"user" | "environment">("environment");
+  const [cameraIndisponivel, setCameraIndisponivel] = useState(false);
+  const videoRef = useRef<HTMLVideoElement>(null);
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const streamRef = useRef<MediaStream | null>(null);
+  const previewsRef = useRef<string[]>([]);
+  const fotosRef = useRef<File[]>([]);
+  const erroTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const cameraRequestIdRef = useRef<number>(0);
+  const adicionarFotoRef = useRef<(file: File) => void>(() => {});
+
+  const { userId, createCheckin, updateCheckin } = useStudyRatsCheckins();
+
+  const maxFotos = tipo === "post" && destino === "story" ? 1 : STUDY_RATS.LIMITES.MAX_FOTOS;
+  const podePublicar = isEditing
+    ? tipo === "checkin"
+      ? Boolean(materia) && duracao > 0
+      : legenda.trim().length > 0 && Boolean(categoria)
+    : tipo === "checkin"
+      ? fotos.length > 0 && materia && duracao > 0
+      : destino === "story"
+        ? fotos.length === 1 && legenda.trim().length > 0 && categoria
+        : legenda.trim().length > 0 && categoria;
+
+  // Função única para mostrar erro com timeout
+  const mostrarErro = useCallback((msg: string) => {
+    if (erroTimeoutRef.current) clearTimeout(erroTimeoutRef.current);
+    setErro(msg);
+    erroTimeoutRef.current = setTimeout(() => setErro(null), 3000);
+  }, []);
+
+  // Validar e adicionar foto
+  const adicionarFoto = useCallback((file: File) => {
+    if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
+      mostrarErro("Formato não suportado. Use JPG, PNG ou WebP.");
+      return;
+    }
+
+    if (fotosRef.current.length >= maxFotos) {
+      mostrarErro(`Máximo de ${maxFotos} foto(s).`);
+      return;
+    }
+
+    if (file.size > STUDY_RATS.LIMITES.MAX_ARQUIVO_MB * 1024 * 1024) {
+      mostrarErro(`Cada foto pode ter no máximo ${STUDY_RATS.LIMITES.MAX_ARQUIVO_MB} MB.`);
+      return;
+    }
+
+    const preview = URL.createObjectURL(file);
+    setFotos(prev => [...prev, file]);
+    setPreviews(prev => [...prev, preview]);
+  }, [maxFotos, mostrarErro]);
+
+  // Sincronizar ref do adicionarFoto
+  useEffect(() => { adicionarFotoRef.current = adicionarFoto; }, [adicionarFoto]);
+
+  // Outros efeitos de sincronização de refs e dados
+  useEffect(() => { previewsRef.current = previews; }, [previews]);
+  useEffect(() => { fotosRef.current = fotos; }, [fotos]);
+  useEffect(() => { streamRef.current = cameraStream; }, [cameraStream]);
+
+  // Quando mudar para story e houver mais de 1 foto, cortar para a primeira
+  useEffect(() => {
+    if (destino === "story" && tipo === "post" && fotos.length > 1) {
+      const extras = fotos.slice(1);
+      extras.forEach((_, i) => URL.revokeObjectURL(previews[i + 1]));
+      setFotos([fotos[0]]);
+      setPreviews([previews[0]]);
+    }
+  }, [destino, tipo, fotos.length, previews.length]);
+
+  // Carregar disciplinas da usuária
+  useEffect(() => {
+    let cancelled = false;
+    if (userId) {
+      getDisciplines(userId).then(result => {
+        if (!cancelled && result.success && result.data) {
+          const validDisciplinas = result.data.filter(d => !d.isdeleted);
+          setDisciplinas(validDisciplinas);
+          if (validDisciplinas.length > 0 && !materia) {
+            setMateria(validDisciplinas[0].name);
+          }
+        }
+        if (!cancelled) setLoadingDisciplinas(false);
+      });
+    }
+    return () => { cancelled = true; };
+  }, [userId, materia]);
+
+  // Limpar previews e stream ao fechar
+  useEffect(() => {
+    return () => {
+      cameraRequestIdRef.current += 1;
+      previewsRef.current.forEach(url => URL.revokeObjectURL(url));
+      if (streamRef.current) {
+        streamRef.current.getTracks().forEach(track => track.stop());
+      }
+      if (erroTimeoutRef.current) clearTimeout(erroTimeoutRef.current);
+    };
+  }, []);
+
+  // Função única para parar stream
+  const pararStream = useCallback(() => {
+    cameraRequestIdRef.current += 1;
+    if (streamRef.current) {
+      streamRef.current.getTracks().forEach(track => track.stop());
+      streamRef.current = null;
+    }
+    setCameraStream(null);
+    setMostrarCamera(false);
+  }, []);
+
+  // Abrir câmera nativa do aparelho (fallback)
+  const abrirCameraDoAparelho = useCallback(() => {
+    const input = document.createElement("input");
+    input.type = "file";
+    input.accept = "image/jpeg,image/png,image/webp";
+    input.setAttribute("capture", "environment");
+    input.onchange = (e) => {
+      const files = Array.from((e.target as HTMLInputElement).files ?? []);
+      if (files[0]) {
+        adicionarFotoRef.current(files[0]);
+      }
+    };
+    input.click();
+  }, []);
+
+  // Iniciar câmera
+  const iniciarCamera = useCallback(async (modo: "user" | "environment" = cameraFacingMode) => {
+    if (!navigator.mediaDevices?.getUserMedia) {
+      mostrarErro("Não foi possível abrir a câmera. Você pode escolher uma foto da galeria.");
+      setCameraIndisponivel(true);
+      return;
+    }
+
+    const requestId = ++cameraRequestIdRef.current;
+    try {
+      const stream = await navigator.mediaDevices.getUserMedia({
+        video: { facingMode: modo, width: { ideal: 1080 }, height: { ideal: 1080 } },
+      });
+      if (requestId !== cameraRequestIdRef.current) {
+        stream.getTracks().forEach(track => track.stop());
+        return;
+      }
+      setCameraStream(stream);
+      streamRef.current = stream;
+      setMostrarCamera(true);
+      setCameraIndisponivel(false);
+    } catch (err) {
+      if (requestId !== cameraRequestIdRef.current) return;
+      const msg = err instanceof Error ? err.message : "Erro ao acessar câmera";
+      console.warn("Câmera não disponível:", msg);
+      mostrarErro("Não foi possível abrir a câmera. Você pode escolher uma foto da galeria.");
+      setCameraIndisponivel(true);
+    }
+  }, [cameraFacingMode, mostrarErro]);
+
+  // useEffect para atribuir stream ao video quando ambos existirem
+  useEffect(() => {
+    if (mostrarCamera && cameraStream && videoRef.current) {
+      videoRef.current.srcObject = cameraStream;
+      videoRef.current.play().catch(() => {});
+    }
+  }, [mostrarCamera, cameraStream]);
+
+  // Capturar foto da câmera
+  const capturarFoto = useCallback(() => {
+    if (!videoRef.current || !canvasRef.current) return;
+
+    const video = videoRef.current;
+    const canvas = canvasRef.current;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+
+    if (video.videoWidth === 0) {
+      mostrarErro("A câmera ainda está iniciando. Tente de novo.");
+      return;
+    }
+
+    const size = Math.min(video.videoWidth, video.videoHeight);
+    const sx = (video.videoWidth - size) / 2;
+    const sy = (video.videoHeight - size) / 2;
+
+    canvas.width = size;
+    canvas.height = size;
+    ctx.drawImage(video, sx, sy, size, size, 0, 0, size, size);
+
+    canvas.toBlob((blob) => {
+      if (blob) {
+        const file = new File([blob], `camera-${uid()}.jpg`, { type: "image/jpeg" });
+        adicionarFotoRef.current(file);
+      }
+    }, "image/jpeg", 0.9);
+
+    pararStream();
+  }, [mostrarErro, pararStream]);
+
+  // Alternar câmera frontal/traseira
+  const alternarCamera = useCallback(() => {
+    const novoModo = cameraFacingMode === "environment" ? "user" : "environment";
+    setCameraFacingMode(novoModo);
+    pararStream();
+    iniciarCamera(novoModo);
+  }, [cameraFacingMode, pararStream, iniciarCamera]);
+
+  // Adicionar foto da galeria
+  const adicionarFotoDaGaleria = useCallback(() => {
+    const espaco = maxFotos - fotosRef.current.length;
+    if (espaco <= 0) {
+      mostrarErro(`Máximo de ${maxFotos} foto(s).`);
+      return;
+    }
+
+    const input = document.createElement("input");
+    input.type = "file";
+    input.accept = "image/jpeg,image/png,image/webp";
+    input.multiple = true;
+    input.onchange = (e) => {
+      const files = Array.from((e.target as HTMLInputElement).files ?? []);
+      const espacoAtual = maxFotos - fotosRef.current.length;
+      if (files.length > espacoAtual) {
+        mostrarErro(`Só cabem ${espacoAtual} foto(s).`);
+      }
+      for (const file of files.slice(0, espacoAtual)) {
+        adicionarFotoRef.current(file);
+      }
+    };
+    input.click();
+  }, [maxFotos, mostrarErro]);
+
+  // Remover foto
+  const removerFoto = useCallback((index: number) => {
+    URL.revokeObjectURL(previews[index]);
+    setFotos(prev => prev.filter((_, i) => i !== index));
+    setPreviews(prev => prev.filter((_, i) => i !== index));
+  }, [previews]);
+
+  // Reordenar fotos
+  const moverFoto = useCallback((fromIndex: number, toIndex: number) => {
+    setFotos(prev => {
+      const novo = [...prev];
+      const [removido] = novo.splice(fromIndex, 1);
+      novo.splice(toIndex, 0, removido);
+      return novo;
+    });
+    setPreviews(prev => {
+      const novo = [...prev];
+      const [removido] = novo.splice(fromIndex, 1);
+      novo.splice(toIndex, 0, removido);
+      return novo;
+    });
+  }, []);
+
+  // Publicar
+  const handlePublicar = useCallback(async () => {
+    if (!tipo || !podePublicar || publicando) return;
+    if (!userId) {
+      setErro("Usuário não autenticado.");
+      return;
+    }
+
+    setPublicando(true);
+    setErro(null);
+
+    try {
+      if (isEditing && editPost) {
+        if (tipo === "checkin") {
+          await updateCheckin(editPost.id, {
+            subject: materia,
+            durationMin: duracao,
+            caption: legenda.trim(),
+          });
+        } else {
+          await updatePost(editPost.id, {
+            category: categoria,
+            caption: legenda.trim(),
+          });
+        }
+      } else {
+        if (tipo === "checkin") {
+          await createCheckin({
+            destination: destino,
+            kind: STUDY_RATS.TIPOS.CHECKIN,
+            subject: materia,
+            durationMin: duracao,
+            caption: legenda.trim() || undefined,
+            files: fotos,
+          });
+        } else {
+          await createPost({
+            destination: destino,
+            kind: STUDY_RATS.TIPOS.POST,
+            category: categoria,
+            caption: legenda.trim(),
+            files: fotos,
+          });
+        }
+      }
+
+      invalidateStudyFeedCache();
+      onPublicado?.();
+      onClose();
+    } catch (err) {
+      const msg = err instanceof Error ? err.message : "Erro ao publicar";
+      setErro(msg);
+    } finally {
+      setPublicando(false);
+    }
+  }, [tipo, podePublicar, publicando, userId, isEditing, editPost, updateCheckin, materia, duracao, legenda, categoria, fotos, destino, createCheckin, createPost, onPublicado, onClose]);
+
+  // Renderização
+  if (!tipo) {
+    return (
+      <div className="srx-overlay fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" onClick={onClose}>
+        <div className="srx-sheet srx-card max-h-[92vh] w-full max-w-md overflow-y-auto rounded-b-none sm:rounded-b-[1.5rem]" onClick={(e) => e.stopPropagation()}>
+          <header className="sticky top-0 z-10 flex items-center border-b border-border bg-surface px-4 py-3">
+            <button aria-label="Fechar" onClick={onClose} className="text-muted-foreground"><X className="h-5 w-5" /></button>
+            <h3 className="mx-auto text-sm font-bold text-foreground">Criar</h3>
+            <span className="w-5" />
+          </header>
+          <div className="space-y-3 p-4">
+            <p className="text-center text-sm text-muted-foreground">O que você quer compartilhar?</p>
+            {([
+              ["checkin", CalendarCheck, "Check-in de estudo", "Foto da sessão, matéria e tempo. Vai para o seu calendário."],
+              ["post", Lightbulb, "Publicação", "Dica de estudo, curiosidade, dúvida ou motivação. Fica no feed e no perfil."],
+            ] as const).map(([k, I, t, d]) => (
+              <button
+                key={k}
+                onClick={() => setTipo(k as TipoPublicacao)}
+                className="flex w-full items-center gap-4 rounded-2xl border border-border bg-surface-2 p-4 text-left transition hover:border-accent"
+              >
+                <span className="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-accent text-accent-foreground"><I className="h-6 w-6" /></span>
+                <span><b className="block text-foreground">{t}</b><span className="text-xs text-muted-foreground">{d}</span></span>
+              </button>
+            ))}
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  const categorias: { value: Categoria; label: string; emoji: string }[] = [
+    { value: "study_tip", label: "Dica de estudo", emoji: "💡" },
+    { value: "curiosity", label: "Curiosidade", emoji: "🔎" },
+    { value: "question", label: "Dúvida", emoji: "❓" },
+    { value: "motivation", label: "Motivação", emoji: "🔥" },
+  ];
+
+  return (
+    <div className="srx-overlay fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" onClick={publicando ? undefined : onClose}>
+      <div className="srx-sheet srx-card max-h-[92vh] w-full max-w-md overflow-y-auto rounded-b-none sm:rounded-b-[1.5rem]" onClick={(e) => e.stopPropagation()}>
+        <header className="sticky top-0 z-10 flex items-center border-b border-border bg-surface px-4 py-3">
+          <button
+            aria-label="Fechar"
+            onClick={() => {
+              if (isEditing) {
+                onClose();
+              } else if (tipoInicial === "escolher" || tipoInicial === undefined) {
+                setTipo(undefined);
+              } else {
+                onClose();
+              }
+            }}
+            disabled={publicando}
+            className="text-muted-foreground disabled:opacity-40"
+          >
+            <X className="h-5 w-5" />
+          </button>
+          <h3 className="mx-auto text-sm font-bold text-foreground">
+            {isEditing ? (tipo === "checkin" ? "Editar check-in" : "Editar publicação") : (tipo === "checkin" ? "Check-in de estudo" : "Nova publicação")}
