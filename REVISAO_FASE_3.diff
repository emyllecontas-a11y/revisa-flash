+import { describe, expect, it } from "vitest";
+import { studyRatsStore, useStudyRats } from "@/components/study-rats/mock-data";
+import { renderHook } from "@testing-library/react";
+
+const estado = () => renderHook(() => useStudyRats()).result.current;
+
+describe("Study Rats: tipos de publicação", () => {
+  it("check-in entra no feed e no calendário", () => {
+    const antes = estado();
+    studyRatsStore.publicar({ tipo: "checkin", materia: "Biologia", duracaoMin: 60, legenda: "" });
+    const depois = estado();
+    expect(depois.posts.length).toBe(antes.posts.length + 1);
+    expect(depois.registros.length).toBe(antes.registros.length + 1);
+  });
+  it("publicação normal entra no feed mas NÃO no calendário", () => {
+    const antes = estado();
+    studyRatsStore.publicar({ tipo: "post", categoria: "Dica de estudo", materia: "Geral", duracaoMin: 0, legenda: "Pomodoro!" });
+    const depois = estado();
+    expect(depois.posts.length).toBe(antes.posts.length + 1);
+    expect(depois.registros.length).toBe(antes.registros.length);
+  });
+});
+
+describe("Study Rats: feed ou stories", () => {
+  it("story não entra no feed, mas aparece nos stories", () => {
+    const antes = estado();
+    studyRatsStore.publicar({ destino: "story", tipo: "post", categoria: "Motivação", materia: "Geral", duracaoMin: 0, legenda: "Bora!" });
+    const depois = estado();
+    expect(depois.posts.length).toBe(antes.posts.length);
+    expect(depois.stories.length).toBe(antes.stories.length + 1);
+  });
+  it("check-in em story continua indo para o calendário", () => {
+    const antes = estado();
+    studyRatsStore.publicar({ destino: "story", tipo: "checkin", materia: "Português", duracaoMin: 30, legenda: "" });
+    expect(estado().registros.length).toBe(antes.registros.length + 1);
+  });
+});
