+import { useState } from "react";
+import { Bookmark, CalendarCheck, Clock, Flame, Heart, Lightbulb, MessageCircle, Plus, X } from "lucide-react";
+import { CATEGORIAS, USUARIA, fmtDuracao, useStudyRats, type Registro } from "./mock-data";
+import { StudyRatsStyles } from "./StudyRatsStyles";
+
+/** Perfil do estudante (aba Comunidade › Study Rats › Meu perfil) — estilo perfil do Instagram.
+ *  As mesmas publicações alimentam o calendário fotográfico da aba Calendários. Somente visual. */
+export function StudyRatsPerfil({ onNovaPublicacao }: { onNovaPublicacao: () => void }) {
+  const { registros, posts } = useStudyRats();
+  const [aba, setAba] = useState<"checkins" | "posts" | "salvos">("checkins");
+  const meus = posts.filter((p) => p.tipo === "post" && p.autor === USUARIA.nome);
+  const salvos = posts.filter((p) => p.salvo);
+  const [aberto, setAberto] = useState<Registro | null>(null);
+  const regs = [...registros].sort((x, y) => (y.data + y.hora).localeCompare(x.data + x.hora));
+  const horas = Math.round(registros.reduce((s, r) => s + r.duracaoMin, 0) / 60);
+
+  return (
+    <div className="mx-auto max-w-[620px] space-y-5">
+      <StudyRatsStyles />
+      <section className="flex items-center gap-5 sm:gap-8">
+        <span className="srx-ring shrink-0"><span className="grid h-20 w-20 place-items-center bg-primary text-2xl font-bold text-primary-foreground sm:h-24 sm:w-24">{USUARIA.iniciais}</span></span>
+        <div className="grid flex-1 grid-cols-3 text-center">
+          {[[regs.length + meus.length, "publicações"], [24, "amizades"], [`${horas}h`, "estudadas"]].map(([v, l]) => (
+            <div key={l}><p className="text-lg font-bold text-foreground">{v}</p><p className="text-xs text-muted-foreground">{l}</p></div>
+          ))}
+        </div>
+      </section>
+      <div className="space-y-1 text-sm">
+        <p className="font-bold text-foreground">{USUARIA.nome}</p>
+        <p className="text-foreground/90">Concurseira 📚 Direito · Português · Biologia</p>
+        <span className="srx-chip"><Flame className="h-3 w-3" /> 7 dias seguidos estudando</span>
+      </div>
+      <div className="flex gap-2">
+        <button className="flex-1 rounded-xl bg-surface-2 py-2 text-sm font-semibold text-foreground">Editar perfil</button>
+        <button onClick={onNovaPublicacao} className="srx-fab flex flex-1 items-center justify-center gap-1.5 rounded-xl py-2 text-sm font-bold"><Plus className="h-4 w-4" /> Nova publicação</button>
+      </div>
+
+      <div className="flex border-t border-border">
+        {([["checkins", CalendarCheck, "Check-ins"], ["posts", Lightbulb, "Publicações"], ["salvos", Bookmark, "Salvos"]] as const).map(([k, I, l]) => (
+          <button key={k} onClick={() => setAba(k)} className={`-mt-px flex flex-1 items-center justify-center gap-1.5 border-t-2 py-3 text-xs font-semibold uppercase tracking-wider ${aba === k ? "border-foreground text-foreground" : "border-transparent text-muted-foreground"}`}>
+            <I className="h-4 w-4" /> {l}
+          </button>
+        ))}
+      </div>
+
+      {aba === "checkins" ? (
+        <div className="-mt-4 grid grid-cols-3 gap-0.5">
+          {regs.map((r) => (
+            <button key={r.id} onClick={() => setAberto(r)} className="srx-tile">
+              <img src={r.foto} alt={r.titulo} />
+              <span className="srx-badge absolute bottom-1 left-1 !px-1.5 !py-0.5 !text-[10px]"><Clock className="h-2.5 w-2.5 text-accent" />{fmtDuracao(r.duracaoMin)}</span>
+              <span className="srx-tile-info"><Heart className="h-4 w-4" fill="currentColor" /> 12 <MessageCircle className="ml-2 h-4 w-4" fill="currentColor" /> 3</span>
+            </button>
