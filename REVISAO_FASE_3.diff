+              <div className="min-w-0 text-sm">
+                <p className="font-bold text-foreground">{p.titulo}</p>
+                <p className="line-clamp-2 text-foreground/80">{p.legenda}</p>
+                <p className="text-xs text-muted-foreground">{p.autor} · ♥ {p.curtidas}</p>
+              </div>
+            </div>
+          ))}
+          {(aba === "posts" ? meus : salvos).length === 0 && <p className="py-10 text-center text-sm text-muted-foreground">{aba === "posts" ? "Compartilhe dicas e curiosidades com a comunidade 💡" : "Publicações que você salvar no feed aparecem aqui (só você vê)."}</p>}
