+
+const SEM = ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"];
+
+/** Calendário de registros fotográficos (aba Calendários). As fotos vêm das publicações feitas na Comunidade. Somente visual. */
+export function StudyRatsCalendario({ onIrParaComunidade }: { onIrParaComunidade?: () => void }) {
+  const [mes] = useState(new Date(2026, 10, 1));
+  const [sel, setSel] = useState("2026-11-24");
+  const [aberto, setAberto] = useState<Registro | null>(null);
+
+  const { registros: REGISTROS } = useStudyRats();
+  const porDia = useMemo(() => {
+    const m: Record<string, Registro[]> = {};
+    REGISTROS.forEach((r) => (m[r.data] ??= []).push(r));
+    return m;
+  }, [REGISTROS]);
+  const diasComRegistro = Object.keys(porDia).length;
+  const totalMin = REGISTROS.reduce((s, r) => s + r.duracaoMin, 0);
+  const ano = mes.getFullYear(), m = mes.getMonth();
+  const inicio = new Date(ano, m, 1).getDay(), qtd = new Date(ano, m + 1, 0).getDate();
+  const iso = (d: number) => `${ano}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+  const nomeMes = mes.toLocaleDateString("pt-BR", { month: "long", year: "numeric" });
+  const fmtDia = (d: string) => new Date(d + "T12:00").toLocaleDateString("pt-BR", { weekday: "long", day: "numeric", month: "long" });
+  const doDia = porDia[sel] ?? [];
+
+  return (
+    <div className="space-y-5">
+      <StudyRatsStyles />
+      <div className="flex flex-wrap items-end justify-between gap-3">
+        <div>
+          <h2 className="flex items-center gap-2 text-lg font-bold text-foreground"><Camera className="h-5 w-5 text-accent" /> Check-ins de estudo</h2>
+          <p className="text-sm text-muted-foreground">{diasComRegistro} dias registrados em {mes.toLocaleDateString("pt-BR", { month: "long" })}</p>
+        </div>
+        <button onClick={onIrParaComunidade} className="srx-chip !py-1.5"><Users className="h-3.5 w-3.5" /> Fazer check-in na Comunidade</button>
+      </div>
+
+      <div className="grid grid-cols-3 gap-3">
+        {[[REGISTROS.length, "registros"], [`${Math.round(totalMin / 60)}h`, "estudadas"], ["7🔥", "dias seguidos"]].map(([v, l]) => (
+          <div key={l} className="srx-card p-3 text-center"><p className="text-xl font-bold text-foreground">{v}</p><p className="text-xs text-muted-foreground">{l}</p></div>
+        ))}
+      </div>
+
+        <div className="grid gap-4 lg:grid-cols-[1fr_320px]">
+          <div className="srx-card p-5">
+            <div className="mb-4 flex items-center justify-between">
+              <button aria-label="Mês anterior" className="srx-icon text-muted-foreground"><ChevronLeft className="h-5 w-5" /></button>
+              <h3 className="font-bold capitalize text-foreground">{nomeMes}</h3>
+              <button aria-label="Próximo mês" className="srx-icon text-muted-foreground"><ChevronRight className="h-5 w-5" /></button>
+            </div>
+            <div className="grid grid-cols-7 gap-1.5 text-center">
+              {SEM.map((s) => <span key={s} className="pb-1 text-xs text-muted-foreground">{s}</span>)}
+              {Array.from({ length: inicio }).map((_, i) => <span key={`v${i}`} />)}
+              {Array.from({ length: qtd }, (_, i) => i + 1).map((d) => {
+                const regs = porDia[iso(d)];
+                return (
+                  <button key={d} onClick={() => setSel(iso(d))} data-sel={sel === iso(d)} className="srx-day text-foreground">
+                    {regs?.[0] ? (
+                      <span className="srx-thumb"><img src={regs[0].foto} alt="" /><span className="srx-thumb-num">{d}</span></span>
+                    ) : d}
+                    {regs && regs.length > 1 && <span className="srx-count">{regs.length}</span>}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+          <aside className="srx-card flex flex-col p-4">
+            <p className="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{fmtDia(sel)}</p>
+            <div className="flex-1 space-y-2.5">
+              {doDia.length === 0 && <p className="py-8 text-center text-sm text-muted-foreground">Nenhum registro neste dia.</p>}
+              {doDia.map((r) => (
+                <button key={r.id} onClick={() => setAberto(r)} className="flex w-full items-center gap-3 rounded-2xl bg-surface-2 p-2.5 text-left transition hover:brightness-110">
+                  <img src={r.foto} alt="" className="h-14 w-14 rounded-xl object-cover" />
+                  <div className="min-w-0 text-sm">
+                    <p className="font-semibold text-foreground">{r.titulo}</p>
+                    <p className="text-xs font-semibold text-accent">{r.materia}</p>
+                    <p className="flex items-center gap-1 text-xs text-muted-foreground"><Clock className="h-3 w-3" /> {r.hora} · {fmtDuracao(r.duracaoMin)}</p>
+                  </div>
+                </button>
+              ))}
+            </div>
+            <p className="mt-4 rounded-2xl bg-surface-2 p-3 text-center text-xs text-muted-foreground">Cada check-in que você faz no Study Rats da Comunidade aparece aqui automaticamente 📸</p>
+          </aside>
+        </div>
+
+      {aberto && (
+        <div className="srx-overlay fixed inset-0 z-50 grid place-items-center p-4" onClick={() => setAberto(null)}>
+          <div className="srx-sheet srx-card w-full max-w-sm overflow-hidden" onClick={(e) => e.stopPropagation()}>
+            <div className="relative"><img src={aberto.foto} alt="" className="aspect-[4/5] w-full object-cover" />
+              <button aria-label="Fechar" onClick={() => setAberto(null)} className="srx-badge absolute right-3 top-3"><X className="h-4 w-4" /></button>
+              <span className="srx-badge absolute left-3 top-3"><Flame className="h-3.5 w-3.5 text-accent" /> {fmtDuracao(aberto.duracaoMin)}</span>
+            </div>
