+import { useSyncExternalStore } from "react";
+// Dados FALSOS apenas para o protótipo visual. Substituir por dados reais (ver IMPLEMENTATION_GUIDE.md).
+export type Comentario = { autor: string; texto: string };
+export type TipoPublicacao = "checkin" | "post";
+export type Categoria = "Dica de estudo" | "Curiosidade" | "Dúvida" | "Motivação";
+export const CATEGORIAS: { nome: Categoria; emoji: string }[] = [
+  { nome: "Dica de estudo", emoji: "💡" }, { nome: "Curiosidade", emoji: "🔎" }, { nome: "Dúvida", emoji: "❓" }, { nome: "Motivação", emoji: "🔥" },
+];
+export type Publicacao = {
+  id: string; tipo: TipoPublicacao; categoria?: Categoria | undefined; autor: string; avatar: string; data: string; // ISO
+  titulo: string; materia: string; duracaoMin: number; legenda: string;
+  fotos: string[]; curtidas: number; curtiu: boolean; salvo: boolean;
+  curtidoPor: string; comentarios: Comentario[];
+};
+export type Story = { id: string; nome: string; avatar: string; foto: string; materia: string; duracaoMin: number; visto: boolean; ha: string;
+  meu?: boolean; texto?: string; categoria?: Categoria | undefined; tipo?: TipoPublicacao };
+export type Destino = "feed" | "story";
+/** Tempo de vida de um story (como no Instagram). */
+export const STORY_DURACAO_HORAS = 24;
+export type Registro = { id: string; data: string /* YYYY-MM-DD */; hora: string; foto: string; titulo: string; materia: string; duracaoMin: number };
+
+const F = (n: number) => `/study-rats/foto${n}.jpg`;
+
+export const USUARIA = { nome: "Emylle Eduarda", iniciais: "EE" };
+
+export const STORIES: Story[] = [
+  { id: "s1", nome: "Natalli", avatar: F(1), foto: F(1), materia: "Direito Constitucional", duracaoMin: 150, visto: false, ha: "1h" },
+  { id: "s2", nome: "Pedro", avatar: F(4), foto: F(4), materia: "Português", duracaoMin: 90, visto: false, ha: "3h" },
+  { id: "s3", nome: "Lorena", avatar: F(3), foto: F(3), materia: "Biologia", duracaoMin: 60, visto: true, ha: "5h" },
+  { id: "s4", nome: "Caio", avatar: F(2), foto: F(2), materia: "Psicologia", duracaoMin: 120, visto: true, ha: "8h" },
+];
+
+export const PUBLICACOES: Publicacao[] = [
+  { id: "p1", tipo: "checkin", autor: "Natalli Perez", avatar: F(1), data: "2026-11-24T10:42:00", titulo: "Constitucional na biblioteca 📚",
+    materia: "Direito Constitucional", duracaoMin: 150, legenda: "Controle de constitucionalidade revisado. Amanhã tem simulado!",
+    fotos: [F(1), F(2)], curtidas: 12, curtiu: true, salvo: false, curtidoPor: "pedro.lima",
+    comentarios: [{ autor: "Luísa", texto: "Me manda o resumo depois 🙏" }, { autor: "Pedro", texto: "Bora que bora!" }] },
+  { id: "p2", tipo: "checkin", autor: "Pedro Lima", avatar: F(4), data: "2026-11-24T08:10:00", titulo: "Café + gramática ☕",
+    materia: "Português", duracaoMin: 90, legenda: "Crase finalmente entrou na cabeça.",
+    fotos: [F(4)], curtidas: 8, curtiu: false, salvo: true, curtidoPor: "natalli",
+    comentarios: [] },
+  { id: "p3", tipo: "checkin", autor: "Lorena Dias", avatar: F(3), data: "2026-11-23T21:15:00", titulo: "Flashcards coloridos 🌈",
+    materia: "Biologia", duracaoMin: 60, legenda: "Revisão de citologia com post-its. Funciona demais!",
+    fotos: [F(3), F(2), F(1)], curtidas: 21, curtiu: false, salvo: false, curtidoPor: "emylle",
+    comentarios: [{ autor: "Ana", texto: "Que organizado!" }] },
+  { id: "p4", tipo: "post", categoria: "Dica de estudo", autor: "Lorena Dias", avatar: F(3), data: "2026-11-24T07:30:00", titulo: "Técnica Pomodoro + revisão ativa",
+    materia: "Geral", duracaoMin: 0, legenda: "25 min estudando, 5 de pausa. Na pausa eu tento lembrar em voz alta o que acabei de ler — dobrou minha retenção! Quem mais usa?",
+    fotos: [], curtidas: 34, curtiu: false, salvo: true, curtidoPor: "natalli", comentarios: [{ autor: "Pedro", texto: "Vou testar hoje!" }] },
+  { id: "p5", tipo: "post", categoria: "Curiosidade", autor: "Pedro Lima", avatar: F(4), data: "2026-11-23T18:00:00", titulo: "Você sabia?",
+    materia: "Português", duracaoMin: 0, legenda: "A palavra \"saudade\" vem do latim solitas — solidão. Caiu numa questão de etimologia que fiz ontem 🤯",
+    fotos: [], curtidas: 19, curtiu: true, salvo: false, curtidoPor: "lorena", comentarios: [] },
+];
+
+const dias: [number, string, number, string, string][] = [
+  [3, "09:00", 2, "Português", "Leitura dirigida"], [4, "14:20", 3, "Biologia", "Mapas mentais"], [6, "19:00", 1, "Direito Constitucional", "Biblioteca"],
+  [10, "08:30", 4, "Português", "Redação"], [11, "16:00", 2, "Psicologia", "Resumo cap. 6"], [12, "10:10", 3, "Biologia", "Flashcards"],
+  [12, "20:00", 2, "Biologia", "Revisão"], [13, "11:00", 1, "Direito Constitucional", "Simulado"], [14, "15:00", 4, "Português", "Exercícios"],
+  [16, "09:40", 2, "Psicologia", "Leitura"], [17, "13:00", 3, "Biologia", "Post-its"], [18, "18:30", 1, "Direito Constitucional", "Revisão"],
+  [18, "21:00", 2, "Português", "Questões"], [19, "10:00", 2, "Psicologia", "Teoria"], [20, "17:00", 4, "Português", "Café e estudo"],
+  [21, "11:30", 3, "Biologia", "Citologia"], [23, "12:05", 1, "Direito Constitucional", "Biblioteca"],
+  [24, "13:30", 4, "Português", "Sessão de estudo"], [24, "21:15", 2, "Português", "Revisão noturna"],
+];
+export const REGISTROS: Registro[] = dias.map(([d, hora, f, materia, titulo], i) => ({
+  id: `r${i}`, data: `2026-11-${String(d).padStart(2, "0")}`, hora, foto: F(f), titulo, materia, duracaoMin: 45 + ((i * 37) % 120),
+}));
+
+// Formatações reais (movidas do protótipo para src/utils/studyRatsFormat.ts).
+// O protótipo continua importando daqui até a Fase 3 trocar os dados falsos.
+export { fmtDuracao, tempoRelativo } from "@/utils/studyRatsFormat";
+
+// ---- Store local do protótipo (substituir por serviço real) ----
+type Estado = { posts: Publicacao[]; registros: Registro[]; stories: Story[] };
+let estado: Estado = { posts: [...PUBLICACOES].sort((a, b) => b.data.localeCompare(a.data)), registros: REGISTROS, stories: STORIES };
+const ouvintes = new Set<() => void>();
+const emitir = (e: Estado) => { estado = e; ouvintes.forEach((f) => f()); };
+export type NovaPublicacao = { destino?: Destino; tipo: TipoPublicacao; categoria?: Categoria | undefined; materia: string; duracaoMin: number; legenda: string; foto?: string | undefined };
+export const studyRatsStore = {
+  atualizarPost: (id: string, f: (p: Publicacao) => Publicacao) => emitir({ ...estado, posts: estado.posts.map((p) => (p.id === id ? f(p) : p)) }),
+  publicar: (n: NovaPublicacao) => {
+    const agora = new Date("2026-11-24T12:00:00"); const id = `n${Date.now()}`;
+    const post: Publicacao = { id, tipo: n.tipo, categoria: n.categoria, autor: USUARIA.nome, avatar: "", data: agora.toISOString().slice(0, 19),
+      titulo: n.tipo === "checkin" ? `Check-in de ${n.materia}` : n.categoria ?? "Publicação", materia: n.materia, duracaoMin: n.duracaoMin,
+      legenda: n.legenda, fotos: n.foto ? [n.foto] : [], curtidas: 0, curtiu: false, salvo: false, curtidoPor: "", comentarios: [] };
+    const registros = n.tipo === "checkin"
+      ? [...estado.registros, { id, data: "2026-11-24", hora: "12:00", foto: n.foto ?? F(2), titulo: `Check-in de ${n.materia}`, materia: n.materia, duracaoMin: n.duracaoMin }]
+      : estado.registros; // publicação normal NÃO vai para o calendário
+    if (n.destino === "story") {
+      const story: Story = { id, nome: "Você", avatar: "", foto: n.foto ?? "", materia: n.materia, duracaoMin: n.duracaoMin, visto: false, ha: "agora",
+        meu: true, texto: n.legenda, categoria: n.categoria, tipo: n.tipo };
+      emitir({ ...estado, registros, stories: [story, ...estado.stories] }); // story some em STORY_DURACAO_HORAS; check-in continua no calendário
+      return;
+    }
+    emitir({ ...estado, posts: [post, ...estado.posts], registros });
+  },
+  marcarStoryVisto: (id: string) => emitir({ ...estado, stories: estado.stories.map((s) => (s.id === id ? { ...s, visto: true } : s)) }),
+};
+export function useStudyRats() {
+  return useSyncExternalStore((f) => (ouvintes.add(f), () => ouvintes.delete(f)), () => estado, () => estado);
+}
