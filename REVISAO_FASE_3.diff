+              <p className="text-muted-foreground">{new Date(aberto.data + "T12:00").toLocaleDateString("pt-BR", { day: "numeric", month: "long" })} · {aberto.hora} · também no seu calendário</p>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
