+// src/contexts/StudyRatsContext.tsx
+//
+// Contexto offline dos CHECK-INS da própria usuária (alimenta calendário, horas e resumo).
+// O RxDB é somente um cache de LEITURA: criar/editar/apagar vão ao Supabase pelo
+// studyRatsService e, em seguida, atualizam o RxDB e o estado local. Publicar sem
+// internet não é permitido (o serviço devolve erro amigável).
+
+import React, {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from 'react';
+import { getDb } from '@/lib/db';
+import { STUDY_RATS } from '@/constants';
+import { localDateStr, localTimeStr } from '@/utils/date';
+import {
+  createPost,
+  deletePost,
+  getCachedUserId,
+  updatePost,
+} from '@/services/studyRatsService';
+import type {
+  CreateStudyPostInput,
+  CreatedStudyPost,
+  StudyCheckinRecord,
+  StudyPostKind,
+  UpdateStudyPostInput,
+} from '@/types/studyRats';
+
+interface StudyRatsContextType {
+  /** Check-ins da própria usuária (não apagados), mais recentes primeiro. */
+  checkins: StudyCheckinRecord[];
+  loading: boolean;
+  userId: string | null;
+  /** Publica um check-in (feed ou story) e grava o cache local. */
+  createCheckin: (input: CreateStudyPostInput) => Promise<CreatedStudyPost>;
+  updateCheckin: (id: string, data: UpdateStudyPostInput) => Promise<void>;
+  deleteCheckin: (id: string) => Promise<void>;
+  refresh: () => Promise<void>;
+}
+
+const StudyRatsContext = createContext<StudyRatsContextType | undefined>(undefined);
+
+function sortCheckins(list: StudyCheckinRecord[]): StudyCheckinRecord[] {
+  return [...list].sort((a, b) => {
+    const dataA = `${a.study_date ?? ''} ${a.study_time ?? ''}`;
+    const dataB = `${b.study_date ?? ''} ${b.study_time ?? ''}`;
+    if (dataA !== dataB) return dataB.localeCompare(dataA);
+    return (b.created_at ?? '').localeCompare(a.created_at ?? '');
+  });
+}
+
+export const StudyRatsProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
+  const [checkins, setCheckins] = useState<StudyCheckinRecord[]>([]);
+  const [userId, setUserId] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  const loadData = useCallback(async () => {
+    try {
+      setLoading(true);
+      const cachedId = getCachedUserId();
+      if (!cachedId) {
+        console.warn('⚠️ [StudyRatsContext] Nenhum usuário disponível.');
+        setLoading(false);
+        return;
+      }
+
+      setUserId(cachedId);
+
+      const db = await getDb();
+      const docs = await db.study_posts.find({
+        selector: {
+          user_id: cachedId,
+          isDeleted: { $ne: true },
+        },
+      }).exec();
+
+      const loaded = sortCheckins(docs.map((doc: any) => doc.toJSON() as StudyCheckinRecord));
+      setCheckins(loaded);
+      console.log(`🐭 [StudyRatsContext] ${loaded.length} check-in(s) carregado(s) do cache local.`);
+    } catch (error) {
+      console.error('❌ [StudyRatsContext] Erro ao carregar check-ins:', error);
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    loadData();
+  }, [loadData]);
+
+  useEffect(() => {
+    let timeoutId: ReturnType<typeof setTimeout> | null = null;
+    let isSubscribed = true;
+    let subscription: { unsubscribe: () => void } | null = null;
+
+    const subscribe = async () => {
+      try {
+        const db = await getDb();
+        if (!db.collections?.study_posts) return;
+
+        subscription = db.study_posts.$.subscribe(() => {
+          if (timeoutId) clearTimeout(timeoutId);
+          timeoutId = setTimeout(() => {
+            if (isSubscribed) {
+              console.log('🔄 [StudyRatsContext] Mudança nos check-ins; recarregando…');
+              loadData();
+            }
+            timeoutId = null;
+          }, 500);
+        });
+      } catch (error) {
+        console.warn('⚠️ [StudyRatsContext] Não foi possível observar a coleção study_posts:', error);
+      }
+    };
+
+    subscribe();
+
+    return () => {
+      isSubscribed = false;
+      if (timeoutId) clearTimeout(timeoutId);
+      subscription?.unsubscribe();
+    };
+  }, [loadData]);
+
+  const createCheckin = useCallback(
+    async (input: CreateStudyPostInput): Promise<CreatedStudyPost> => {
+      const kind: StudyPostKind = input.kind;
+      if (kind !== STUDY_RATS.TIPOS.CHECKIN) {
+        throw new Error('O StudyRatsContext só grava check-ins.');
+      }
+
+      const ownerId = userId ?? getCachedUserId();
+      if (!ownerId) throw new Error('Usuário não autenticado');
+
+      const result = await createPost(input);
+      if (!result.postId) return result;
+
+      const subject = input.subject?.trim() || null;
+      const record: StudyCheckinRecord = {
+        id: result.postId,
+        user_id: ownerId,
+        kind: STUDY_RATS.TIPOS.CHECKIN,
+        category: null,
+        title: result.title ?? (subject ? `Check-in de ${subject}` : 'Check-in de estudo'),
+        caption: input.caption?.trim() || null,
+        subject,
+        duration_min: result.durationMin ?? Number(input.durationMin ?? 0),
+        study_date: result.studyDate ?? input.studyDate ?? localDateStr(),
+        study_time: result.studyTime ?? localTimeStr(),
+        in_feed: input.destination === STUDY_RATS.DESTINOS.FEED,
+        created_at: new Date().toISOString(),
+        updated_at: new Date().toISOString(),
+        isDeleted: false,
+        photos: result.photos.map((photo) => ({
+          id: photo.id,
+          path: photo.path,
+          position: photo.position,
+        })),
+      };
+
+      try {
+        const db = await getDb();
+        const existing = await db.study_posts.findOne({ selector: { id: record.id } }).exec();
+        if (existing) {
+          await existing.patch(record);
+        } else {
+          await db.study_posts.insert(record);
+        }
+      } catch (rxError) {
+        console.warn('⚠️ [StudyRatsContext] Falha ao gravar check-in no cache local (já publicado no servidor):', rxError);
+      }
+
+      setCheckins((prev) =>
+        sortCheckins([record, ...prev.filter((item) => item.id !== record.id)]),
+      );
+      console.log('✅ [StudyRatsContext] Check-in publicado e salvo no cache local:', record.id);
+
+      return result;
+    },
+    [userId],
+  );
+
+  const updateCheckin = useCallback(
+    async (id: string, data: UpdateStudyPostInput): Promise<void> => {
+      await updatePost(id, data);
+
+      const patch: Partial<StudyCheckinRecord> = { updated_at: new Date().toISOString() };
+      if (data.title !== undefined) patch.title = data.title.trim() || null;
+      if (data.caption !== undefined) patch.caption = data.caption.trim() || null;
+      if (data.category !== undefined) patch.category = data.category ?? null;
+      if (data.subject !== undefined) patch.subject = data.subject.trim() || null;
+      if (data.durationMin !== undefined) patch.duration_min = Number(data.durationMin);
+
+      try {
+        const db = await getDb();
+        const doc = await db.study_posts.findOne({ selector: { id } }).exec();
+        if (doc) await doc.patch(patch);
+      } catch (rxError) {
+        console.warn('⚠️ [StudyRatsContext] Falha ao atualizar check-in no cache local:', rxError);
+      }
+
+      setCheckins((prev) =>
+        sortCheckins(prev.map((item) => (item.id === id ? { ...item, ...patch } : item))),
+      );
+      console.log('✏️ [StudyRatsContext] Check-in atualizado:', id);
+    },
+    [],
+  );
+
+  const deleteCheckin = useCallback(async (id: string): Promise<void> => {
+    await deletePost(id);
+
+    try {
+      const db = await getDb();
+      const doc = await db.study_posts.findOne({ selector: { id } }).exec();
+      if (doc) {
+        await doc.patch({ isDeleted: true, updated_at: new Date().toISOString() });
+      }
+    } catch (rxError) {
+      console.warn('⚠️ [StudyRatsContext] Falha ao marcar check-in como excluído no cache local:', rxError);
+    }
+
+    setCheckins((prev) => prev.filter((item) => item.id !== id));
+    console.log('🗑️ [StudyRatsContext] Check-in excluído:', id);
+  }, []);
+
+  const refresh = useCallback(async () => {
+    await loadData();
+  }, [loadData]);
+
+  const value = useMemo(
+    () => ({
+      checkins,
+      loading,
+      userId,
+      createCheckin,
+      updateCheckin,
+      deleteCheckin,
+      refresh,
+    }),
+    [checkins, loading, userId, createCheckin, updateCheckin, deleteCheckin, refresh],
+  );
+
+  return <StudyRatsContext.Provider value={value}>{children}</StudyRatsContext.Provider>;
+};
+
+export const useStudyRatsCheckins = () => {
+  const context = useContext(StudyRatsContext);
+  if (!context) {
+    throw new Error('useStudyRatsCheckins deve ser usado dentro de StudyRatsProvider');
+  }
+  return context;
+};
diff --git a/src/hooks/useStudyRats.ts b/src/hooks/useStudyRats.ts
new file mode 100644
index 00000000..4b869a94
--- /dev/null
+++ b/src/hooks/useStudyRats.ts
@@ -0,0 +1,448 @@
+// src/hooks/useStudyRats.ts
+//
+// Hooks do Study Rats. Sem react-query: estado React + cache simples em memória
+// (o queryClient do app existe, mas não é usado em nenhuma tela).
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import {
+  getFeed,
+  getProfile,
+  getSignedPhotoUrls,
+  getStories,
+  cleanupExpiredStories,
+  getCachedUserId,
+  markStoryViewed,
+  studyRatsErrorMessage,
+  toggleLike,
+  toggleSave,
+} from '@/services/studyRatsService';
+import { useStudyRatsCheckins } from '@/contexts/StudyRatsContext';
+import { isDateInMonth } from '@/utils/date';
+import type {
+  StudyCalendarEntry,
+  StudyFeedCursor,
+  StudyFeedFilter,
+  StudyPost,
+  StudyProfileStats,
+  StudyStory,
+} from '@/types/studyRats';
+
+// ============================================================
+// CACHE EM MEMÓRIA DO FEED
+// ============================================================
+
+interface FeedCacheEntry {
+  posts: StudyPost[];
+  nextCursor: StudyFeedCursor | null;
+  at: number;
+}
+
+const FEED_CACHE_TTL_MS = 60_000;
+const feedCache = new Map<string, FeedCacheEntry>();
+
+function cacheKey(filter?: StudyFeedFilter): string {
+  return JSON.stringify(filter ?? {});
+}
+
+/** Invalida todo o cache do feed em memória (usado após publicar/editar/excluir). */
+export function invalidateStudyFeedCache(): void {
+  feedCache.clear();
+}
+
+// ============================================================
+// useStudyFeed — paginação infinita + curtir/salvar otimistas
+// ============================================================
+
+export function useStudyFeed(filter?: StudyFeedFilter) {
+  const key = cacheKey(filter);
+  const cached = feedCache.get(key);
+
+  const [posts, setPosts] = useState<StudyPost[]>(cached?.posts ?? []);
+  const [nextCursor, setNextCursor] = useState<StudyFeedCursor | null>(
+    cached?.nextCursor ?? null,
+  );
+  const [loading, setLoading] = useState(!cached);
+  const [loadingMore, setLoadingMore] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const postsRef = useRef<StudyPost[]>(posts);
+  const filterRef = useRef<StudyFeedFilter | undefined>(filter);
+  filterRef.current = filter;
+  const keyRef = useRef(key);
+  keyRef.current = key;
+
+  const commit = useCallback(
+    (next: StudyPost[], cursor?: StudyFeedCursor | null) => {
+      postsRef.current = next;
+      setPosts(next);
+
+      const previous = feedCache.get(key);
+      const nextCursorValue = cursor === undefined ? previous?.nextCursor ?? null : cursor;
+      feedCache.set(key, { posts: next, nextCursor: nextCursorValue, at: Date.now() });
+      setNextCursor(nextCursorValue);
+    },
+    [key],
+  );
+
+  useEffect(() => {
+    const entry = feedCache.get(key);
+    if (entry && Date.now() - entry.at < FEED_CACHE_TTL_MS) {
+      postsRef.current = entry.posts;
+      setPosts(entry.posts);
+      setNextCursor(entry.nextCursor);
+      setError(null);
+      setLoading(false);
+      return;
+    }
+
+    // Reset antes de buscar: evita lista antiga na tela e ações no filtro errado
+    postsRef.current = [];
+    setPosts([]);
+    setNextCursor(null);
+
+    let cancelled = false;
+    setLoading(true);
+    setError(null);
+
+    getFeed({ filter: filterRef.current })
+      .then((page) => {
+        if (cancelled) return;
+        postsRef.current = page.posts;
+        setPosts(page.posts);
+        setNextCursor(page.nextCursor);
+        feedCache.set(key, { posts: page.posts, nextCursor: page.nextCursor, at: Date.now() });
+      })
+      .catch((err) => {
+        if (!cancelled) setError(studyRatsErrorMessage(err));
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [key]);
+
+  const refresh = useCallback(async () => {
+    setLoading(true);
+    setError(null);
+    try {
+      const page = await getFeed({ filter: filterRef.current });
+      commit(page.posts, page.nextCursor);
+    } catch (err) {
+      setError(studyRatsErrorMessage(err));
+    } finally {
+      setLoading(false);
+    }
+  }, [commit]);
+
+  const loadMore = useCallback(async () => {
+    const cursor = nextCursor;
+    const fetchKey = key; // guarda a chave antes do await
+    if (!cursor || loadingMore) return;
+
+    setLoadingMore(true);
+    try {
+      const page = await getFeed({ cursor, filter: filterRef.current });
+      // Se o filtro mudou durante o fetch, descarta o resultado
+      if (fetchKey !== keyRef.current) return;
+      const existing = new Set(postsRef.current.map((post) => post.id));
+      const merged = [...postsRef.current, ...page.posts.filter((post) => !existing.has(post.id))];
+      commit(merged, page.nextCursor);
+    } catch (err) {
+      if (fetchKey === keyRef.current) setError(studyRatsErrorMessage(err));
+    } finally {
+      setLoadingMore(false);
+    }
+  }, [nextCursor, loadingMore, commit]);
+
+  const likePost = useCallback(
+    async (postId: string, onlyLike = false) => {
+      const current = postsRef.current.find((post) => post.id === postId);
+      if (!current) return;
+      if (onlyLike && current.likedByMe) return;
+
+      const nextLiked = onlyLike ? true : !current.likedByMe;
+      const optimistic = postsRef.current.map((post) =>
+        post.id === postId
+          ? {
+              ...post,
+              likedByMe: nextLiked,
+              likesCount: Math.max(0, post.likesCount + (nextLiked ? 1 : -1)),
+            }
+          : post,
+      );
+      commit(optimistic);
+
+      try {
+        const result = await toggleLike(postId, { onlyLike });
+        if (result.liked !== nextLiked) {
+          commit(
+            postsRef.current.map((post) =>
+              post.id === postId
+                ? {
+                    ...post,
+                    likedByMe: result.liked,
+                    likesCount: Math.max(0, post.likesCount + (result.liked ? 1 : -1)),
+                  }
+                : post,
+            ),
+          );
+        }
+      } catch (err) {
+        commit(
+          postsRef.current.map((post) =>
+            post.id === postId
+              ? { ...post, likedByMe: current.likedByMe, likesCount: current.likesCount }
+              : post,
+          ),
+        );
+        setError(studyRatsErrorMessage(err));
+      }
+    },
+    [commit],
+  );
+
+  const savePost = useCallback(
+    async (postId: string) => {
+      const current = postsRef.current.find((post) => post.id === postId);
+      if (!current) return;
+
+      const nextSaved = !current.savedByMe;
+      commit(
+        postsRef.current.map((post) =>
+          post.id === postId ? { ...post, savedByMe: nextSaved } : post,
+        ),
+      );
+
+      try {
+        const result = await toggleSave(postId);
+        if (result.saved !== nextSaved) {
+          commit(
+            postsRef.current.map((post) =>
+              post.id === postId ? { ...post, savedByMe: result.saved } : post,
+            ),
+          );
+        }
+      } catch (err) {
+        commit(
+          postsRef.current.map((post) =>
+            post.id === postId ? { ...post, savedByMe: current.savedByMe } : post,
+          ),
+        );
+        setError(studyRatsErrorMessage(err));
+      }
+    },
+    [commit],
+  );
+
+  return {
+    posts,
+    loading,
+    loadingMore,
+    error,
+    hasMore: Boolean(nextCursor),
+    refresh,
+    loadMore,
+    likePost,
+    savePost,
+    /** Atualiza o contador de comentários de um post (otimista). */
+    updateCommentsCount: useCallback(
+      (postId: string, delta: number) => {
+        commit(
+          postsRef.current.map((post) =>
+            post.id === postId
+              ? { ...post, commentsCount: Math.max(0, post.commentsCount + delta) }
+              : post,
+          ),
+        );
+      },
+      [commit],
+    ),
+  };
+}
+
+// ============================================================
+// useStories
+// ============================================================
+
+export function useStories() {
+  const [stories, setStories] = useState<StudyStory[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    setError(null);
+    try {
+      const list = await getStories();
+      setStories(list);
+    } catch (err) {
+      setError(studyRatsErrorMessage(err));
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    load();
+    // Limpeza em segundo plano; não trava a tela e ignora erros.
+    void cleanupExpiredStories();
+  }, [load]);
+
+  const markViewed = useCallback(async (storyId: string) => {
+    setStories((prev) =>
+      prev.map((story) => (story.id === storyId ? { ...story, viewedByMe: true } : story)),
+    );
+    try {
+      await markStoryViewed(storyId);
+    } catch {
+      // O anel de "visto" nunca deve quebrar a visualização.
+    }
+  }, []);
+
+  return { stories, loading, error, refresh: load, markViewed };
+}
+
+// ============================================================
+// useStudyProfile
+// ============================================================
+
+export function useStudyProfile(userId?: string) {
+  const currentUserId = getCachedUserId();
+  const targetId = userId ?? currentUserId;
+
+  const [profile, setProfile] = useState<StudyProfileStats | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [reloadAt, setReloadAt] = useState(0);
+
+  useEffect(() => {
+    if (!targetId) {
+      setProfile(null);
+      setLoading(false);
+      return;
+    }
+
+    let cancelled = false;
+    setLoading(true);
+    setError(null);
+
+    getProfile(targetId)
+      .then((result) => {
+        if (!cancelled) setProfile(result);
+      })
+      .catch((err) => {
+        if (!cancelled) setError(studyRatsErrorMessage(err));
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [targetId, reloadAt]);
+
+  const refresh = useCallback(() => {
+    setReloadAt((value) => value + 1);
+  }, []);
+
+  return {
+    profile,
+    loading,
+    error,
+    refresh,
+    userId: targetId,
+    isMe: Boolean(targetId && currentUserId && targetId === currentUserId),
+  };
+}
+
+// ============================================================
+// useCalendarCheckins — lê do cache local (RxDB) e assina as fotos
+// ============================================================
+
+export function useCalendarCheckins(year: number, month: number) {
+  const { checkins, loading: contextLoading, refresh } = useStudyRatsCheckins();
+  const [urls, setUrls] = useState<Map<string, string>>(new Map());
+  const [urlsLoading, setUrlsLoading] = useState(false);
+
+  const entries = useMemo<StudyCalendarEntry[]>(() => {
+    return checkins
+      .filter((checkin) => isDateInMonth(checkin.study_date, year, month))
+      .map((checkin) => ({
+        id: checkin.id,
+        studyDate: checkin.study_date,
+        studyTime: checkin.study_time,
+        subject: checkin.subject,
+        durationMin: checkin.duration_min,
+        title: checkin.title,
+        caption: checkin.caption,
+        inFeed: checkin.in_feed,
+        createdAt: checkin.created_at,
+        photos: [...(checkin.photos ?? [])]
+          .sort((a, b) => a.position - b.position)
+          .map((photo) => ({
+            path: photo.path,
+            position: photo.position,
+            url: urls.get(photo.path) ?? null,
+          })),
+      }))
+      .sort((a, b) => {
+        const da = `${a.studyDate} ${a.studyTime ?? ''}`;
+        const db = `${b.studyDate} ${b.studyTime ?? ''}`;
+        return da.localeCompare(db);
+      });
+  }, [checkins, year, month, urls]);
+
+  const paths = useMemo(
+    () => entries.flatMap((entry) => entry.photos.map((photo) => photo.path)),
+    [entries],
+  );
+  const pathsKey = paths.join('|');
+
+  useEffect(() => {
+    if (!pathsKey) {
+      setUrls(new Map());
+      return;
+    }
+
+    let cancelled = false;
+    setUrlsLoading(true);
+
+    getSignedPhotoUrls(pathsKey.split('|'))
+      .then((map) => {
+        if (!cancelled) setUrls(map);
+      })
+      .finally(() => {
+        if (!cancelled) setUrlsLoading(false);
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [pathsKey]);
+
+  const byDate = useMemo(() => {
+    const grouped: Record<string, StudyCalendarEntry[]> = {};
+    for (const entry of entries) {
+      (grouped[entry.studyDate] ??= []).push(entry);
+    }
+    return grouped;
+  }, [entries]);
+
+  const totalMinutes = useMemo(
+    () => entries.reduce((sum, entry) => sum + entry.durationMin, 0),
+    [entries],
+  );
+
+  return {
+    entries,
+    byDate,
+    totalMinutes,
+    daysCount: Object.keys(byDate).length,
+    loading: contextLoading || urlsLoading,
+    refresh,
+  };
+}
