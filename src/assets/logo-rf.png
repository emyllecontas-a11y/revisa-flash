<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <!-- Cartão rosa (F) -->
  <g transform="rotate(8.5 326 218)">
    <rect x="226" y="118" width="200" height="200" rx="22" fill="#E8185F"/>
    <rect x="240" y="132" width="172" height="172" rx="12" fill="none" stroke="#2B0F23" stroke-width="4"/>
    <!-- F pequeno -->
    <path d="M258 140 V122 H271 M258 131 H269" fill="none" stroke="#2B0F23" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- F grande -->
    <path d="M322 282 V166 H394 M322 220 H382" fill="none" stroke="#2B0F23" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Cartão laranja (R) -->
  <g transform="rotate(-8.5 187 296)">
    <rect x="87" y="196" width="200" height="200" rx="22" fill="#F77F00" stroke="#2B0F23" stroke-width="8" paint-order="stroke"/>
    <rect x="101" y="210" width="172" height="172" rx="12" fill="none" stroke="#2B0F23" stroke-width="4"/>
    <!-- R pequeno -->
    <path d="M236 206 V191 H244 a5.5 5.5 0 0 1 0 11 H236 M244 202 L250 207" fill="none" stroke="#2B0F23" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- R grande -->
    <path d="M148 348 V256 H193 a28 28 0 0 1 0 58 H148 M190 314 L228 348" fill="none" stroke="#2B0F23" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Raio -->
  <path d="M296 200 L262 252 H280 L259 316 L306 244 H287 Z" fill="#2B0F23" stroke="#2B0F23" stroke-width="4" stroke-linejoin="round"/>
</svg>
